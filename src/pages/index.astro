---
// Home: hero, case study cards and experience.
// Copy is from the Figma Home frames. Words that Figma's manual line breaks
// had fused together (e.g. "clientsincluding") are rejoined with a space.
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import WorkCard from '../components/WorkCard.astro';
import Experience from '../components/Experience.astro';

import calastoneThumb from '../assets/work/calastone-thumb.png';
import bambooThumb from '../assets/work/bamboo-thumb.png';
import juicywayThumb from '../assets/work/juicyway-thumb.png';
import finxThumb from '../assets/work/finx-thumb.png';
---

<BaseLayout
  title="Tomasz Zastawny | Senior Product Designer"
  description="12 years in design, working across UX, UI and systems. From trading infrastructure to consumer apps in emerging markets, I’ve spent that time where the rules matter and small UI decisions carry real weight."
>
  <main class="page">
    <!-- Hero -->
    <section class="hero">
      <div class="name">
        <h1 data-scramble>Tomasz Zastawny</h1>
        <p class="role">Senior product designer</p>
      </div>
      <div class="intro">
        <p class="summary">
          12 years in design, working across UX, UI and systems. From trading infrastructure to consumer apps in
          emerging markets, I’ve spent that time where the rules matter and small UI decisions carry real weight.
        </p>
        <span class="status-pill" data-pill-group><span data-pill><Tag dot>Open to work</Tag></span></span>
      </div>
    </section>

    <!-- Case studies -->
    <section class="work">
      <WorkCard
        href="/calastone"
        palette="calastone"
        title="Calastone"
        meta="Institutional fintech - fund services"
        image={calastoneThumb}
        sizes="(max-width: 799.98px) calc(100vw - 40px), (max-width: 1279.98px) 75vw, 925px"
        alt=""
        eager
      />
      <WorkCard
        href="/bamboo"
        palette="bamboo"
        title="Bamboo"
        meta="Consumer fintech - retail investing"
        image={bambooThumb}
        sizes="(max-width: 799.98px) calc(100vw - 40px), (max-width: 1279.98px) 75vw, 925px"
        alt=""
        tint
        eager
      />
      <WorkCard
        href="/juicyway"
        palette="juicyway"
        title="Juicyway"
        meta="Consumer & B2B fintech"
        image={juicywayThumb}
        sizes="(max-width: 799.98px) calc(100vw - 40px), (max-width: 1279.98px) 75vw, 925px"
        alt=""
      />
      <!-- The FinX image is already dark and has the card's background, so it's shown whole and not faded -->
      <WorkCard title="FinX" meta="Complex design system for fintech" image={finxThumb} alt="" soon fit="contain" dim={false} sizes="(max-width: 799.98px) calc(100vw - 40px), (max-width: 1279.98px) 75vw, 925px" />
    </section>

    <!-- Experience -->
    <section class="experience">
      <h2 class="section-title">Experience</h2>

      <Experience />
    </section>

    <footer class="footer">
      <p>zastawny ©2026</p>
    </footer>
  </main>
  <div class="bottom-shade" aria-hidden="true"></div>
</BaseLayout>

<script>
  // Case study tiles: open the one under the mouse, the focused one, or the tapped one.
  // On touch, the first tap opens a tile and the second follows its link. On phones the tiles stack and links work at once.
  const stacked = window.matchMedia('(max-width: 799.98px)');

  document.addEventListener('astro:page-load', () => {
    const work = document.querySelector<HTMLElement>('.work');
    if (!work) return;
    const cards = [...work.querySelectorAll<HTMLElement>('.card')];
    const open = (card: HTMLElement | null) => {
      for (const c of cards) c.classList.toggle('is-open', c === card);
      work.classList.toggle('has-open', !!card);
    };
    // A short pause before opening, so sweeping the mouse across the tiles doesn't open each one on the way
    let wait = 0;
    work.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      clearTimeout(wait);
      open(null);
    });
    for (const card of cards) {
      card.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        clearTimeout(wait);
        wait = window.setTimeout(() => open(card), 90);
      });
      card.addEventListener('focus', () => {
        if (card.matches(':focus-visible')) open(card);
      });
      card.addEventListener('blur', () => open(null));
      card.addEventListener('click', (e) => {
        if (stacked.matches || card.classList.contains('is-open')) return;
        e.preventDefault();
        open(card);
      });
    }
  });
</script>

<style>
  .page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding-top: var(--page-top);
  }

  /* ---------- Hero ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 0 var(--gutter);
    text-align: center;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-display-auto);
    letter-spacing: 0;
    color: var(--color-text);
  }

  .role {
    color: var(--color-text);
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .summary {
    max-width: 524px;
    color: var(--color-text);
  }

  /* ---------- Case study cards ---------- */
  /*
    Four portrait tiles side by side. The hovered (or tapped, or focused) one opens to the width
    of three closed tiles, the others narrow and hide their text. The picture inside each tile is
    always the open width and centred, so opening only reveals more of it (and the datamosh
    canvas never has to resize).
  */
  .work {
    --gap: 20px;
    --closed: calc((100cqw - 3 * var(--gap)) / 4);
    --open: calc(3 * var(--closed) + 2 * var(--gap));
    container-type: inline-size;
    display: flex;
    gap: var(--gap);
    height: 520px;
    margin-top: 60px;
    padding: 0 var(--gutter);
    margin-bottom: 64px;
  }

  .work :global(.card) {
    position: relative;
    display: block;
    flex: 1 1 0;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    background: none;
    transition: flex 800ms cubic-bezier(0.45, 0, 0.2, 1);
  }
  .work :global(.card.is-open) {
    flex: 0 0 var(--open);
  }

  .work :global(.thumb) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: var(--open);
    height: auto;
    transform: translateX(-50%);
  }

  /* Shade behind the title so it reads on light pictures */
  .work :global(.card)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.2), rgb(0 0 0 / 0) 45%);
    pointer-events: none;
  }

  /* Title and subtitle at the bottom left, as wide as a closed tile so they never reflow */
  .work :global(.text) {
    position: absolute;
    bottom: 20px;
    left: 20px;
    z-index: 1;
    width: calc(var(--closed) - 40px);
    transition: opacity 300ms;
  }

  .work:global(.has-open) :global(.card:not(.is-open) .text) {
    opacity: 0;
  }

  /* ---------- Experience ---------- */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0 var(--content-gutter);
    padding-top: 64px;
    border-top: 1px dashed var(--color-divider);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: 0.9;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-text);
  }

  /* The job list sits 120px in from each side on desktop */
  .experience :global(.jobs) {
    padding: 0 120px;
  }

  .footer {
    padding: 90px var(--content-gutter) 60px; /* 30px list gap + 60px, as in Figma */
    font-size: var(--text-caption);
    text-align: center;
    color: var(--color-text);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1279.98px) {
    .summary {
      max-width: 488px;
    }

    /* A tighter gap and inset, so the longest titles fit a closed tile down to 800px */
    .work {
      --gap: 12px;
    }
    .work :global(.text) {
      bottom: 16px;
      left: 16px;
      width: calc(var(--closed) - 32px);
    }

    /* Figma: a 560px column, 120px in from each side at 800px. Centred at wider tablet widths. */
    .experience {
      width: min(560px, calc(100% - 2 * var(--content-gutter)));
      margin: 0 auto;
    }

    .experience :global(.jobs) {
      padding: 0;
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 799.98px) {
    /* Cards and experience stay in a 496px column, so wide phones keep side gutters */
    /* Phones: the tiles stack, full width, with their titles */
    .work {
      flex-direction: column;
      gap: 12px;
      height: auto;
      max-width: calc(496px + 2 * var(--gutter));
      margin-left: auto;
      margin-right: auto;
    }
    .work :global(.card),
    .work :global(.card.is-open) {
      flex: none;
      height: 320px;
    }
    .work :global(.thumb) {
      left: 0;
      width: 100%;
      transform: none;
    }
    .work :global(.text) {
      right: 20px;
      bottom: 20px;
      left: 20px;
      width: auto;
    }
    .work :global(.card .text),
    .work :global(.card)::after {
      opacity: 1 !important;
    }

    .experience {
      width: min(496px, calc(100% - 2 * var(--content-gutter)));
    }

    .footer {
      padding-top: 60px;
    }
  }
</style>
