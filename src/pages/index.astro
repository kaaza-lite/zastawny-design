---
// Home: hero, case study cards and experience.
// Copy is from the Figma Home frames. Words that Figma's manual line breaks
// had fused together (e.g. "clientsincluding") are rejoined with a space.
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import WorkCard from '../components/WorkCard.astro';
import Experience from '../components/Experience.astro';

import calastoneThumb from '../assets/work/calastone-thumb.png';
import bambooThumb from '../assets/work/bamboo-thumb.png';
import juicywayThumb from '../assets/work/juicyway-thumb.png';
import finxThumb from '../assets/work/finx-thumb.png';
---

<BaseLayout
  title="Tomasz Zastawny | Senior Product Designer"
  description="12 years in design and 7 years in fintech, spanning institutional fund infrastructure, retail trading, and emerging market consumer products."
>
  <main class="page">
    <!-- Hero -->
    <section class="hero">
      <div class="name">
        <h1 data-scramble>tomasz zastawny</h1>
        <p class="role">senior product designer</p>
      </div>
      <div class="intro">
        <p class="summary">
          12 years in design and 7 years in fintech, spanning institutional fund infrastructure, retail trading, and
          emerging market consumer products.
        </p>
        <Tag dot>open to work</Tag>
      </div>
    </section>

    <!-- Case studies -->
    <section class="work">
      <WorkCard
        href="/calastone"
        palette="calastone"
        title="calastone"
        meta="institutional fintech - fund services"
        image={calastoneThumb}
        alt=""
        eager
      />
      <WorkCard
        href="/bamboo"
        palette="bamboo"
        title="bamboo"
        meta="consumer fintech - retail investing"
        image={bambooThumb}
        alt=""
        tint
        eager
      />
      <WorkCard
        href="/juicyway"
        palette="juicyway"
        title="juicyway"
        meta="consumer & B2B fintech"
        image={juicywayThumb}
        alt=""
      />
      <!-- The FinX image is already dark and has the card's background, so it's shown whole and not faded -->
      <WorkCard title="finx" meta="complex design system for fintech" image={finxThumb} alt="" soon fit="contain" dim={false} />
    </section>

    <!-- Experience -->
    <section class="experience">
      <h2 class="section-title">experience</h2>

      <Experience />
    </section>

    <footer class="footer">
      <p>zastawny ©2026</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .page {
    max-width: var(--page-width);
    margin: 0 auto;
    padding-top: var(--page-top);
  }

  /* ---------- Hero ---------- */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 0 var(--gutter);
    text-align: center;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-display-auto);
    letter-spacing: 0;
    color: var(--color-text);
  }

  .role {
    color: var(--color-text);
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .summary {
    max-width: 524px;
    color: var(--color-text-muted);
  }

  /* ---------- Case study cards ---------- */
  .work {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 60px;
    padding: 0 var(--gutter) 64px;
  }

  /* ---------- Experience ---------- */
  .experience {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0 var(--content-gutter);
    padding-top: 64px;
    border-top: 1px dashed var(--color-divider);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: 0.9;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-text);
  }

  /* The job list sits 120px in from each side on desktop */
  .experience :global(.jobs) {
    padding: 0 120px;
  }

  .footer {
    padding: 90px var(--content-gutter) 60px; /* 30px list gap + 60px, as in Figma */
    font-size: var(--text-caption);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1279.98px) {
    .summary {
      max-width: 488px;
    }

    .work {
      row-gap: 48px;
    }

    /* Figma: a 560px column, 120px in from each side at 800px. Centred at wider tablet widths. */
    .experience {
      width: min(560px, calc(100% - 2 * var(--content-gutter)));
      margin: 0 auto;
    }

    .experience :global(.jobs) {
      padding: 0;
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 799.98px) {
    /* Cards and experience stay in a 496px column, so wide phones keep side gutters */
    .work {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      max-width: calc(496px + 2 * var(--gutter));
      margin-left: auto;
      margin-right: auto;
    }

    .experience {
      width: min(496px, calc(100% - 2 * var(--content-gutter)));
    }

    .footer {
      padding-top: 60px;
    }
  }
</style>
