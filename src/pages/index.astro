---
// Home. Step 1 shell: only the hero name and title, to check fonts and tokens.
// The full page is built in Step 2.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="tomasz zastawny">
  <main class="shell">
    <h1>tomasz zastawny</h1>
    <p>senior product designer</p>
  </main>
</BaseLayout>

<style>
  .shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    text-align: center;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-h1);
  }
</style>
