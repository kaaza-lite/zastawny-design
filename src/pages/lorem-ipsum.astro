---
// The experimental page (/lorem-ipsum, not linked from the nav for now). A title and a short
// description at the top, and under them one curved 3D wall of projects on a solid grey
// background that follows the mouse and zooms with the scroll wheel (src/scripts/curve.ts). Clicking a tile opens a glass modal with that project's images,
// one per scroll. All the content is placeholder for now (src/data/peek.ts).
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/peek';

// Each project's images at tile size, for the grid's textures
const tileImages = await Promise.all(
  projects.map(async (p) => ({
    images: await Promise.all(p.images.map(async (img) => (await getImage({ src: img.src, width: 640, format: 'webp' })).src)),
  })),
);
---

<BaseLayout title="Redesigns | Tomasz Zastawny" description="Past projects, redesigned with today’s thinking. Fintech, health tech, transportation and more. Not shipped, just better." page="peek">
  <main class="peek">
    <header class="peek-header">
      <h1 data-scramble>Redesigns</h1>
      <p class="peek-intro">
        Past projects, redesigned with today’s thinking. Fintech, health tech, transportation and more. Not shipped,
        just better.
      </p>
    </header>
    <div class="peek-stage" data-projects={JSON.stringify(tileImages)}>
      <div class="peek-canvas" aria-hidden="true"></div>
      <!-- The same projects for keyboard and screen readers; shown when one has focus -->
      <ul class="peek-list" aria-label="Projects">
        {projects.map((p, i) => (
          <li><button type="button" class="peek-open" data-project={i}>{p.title}, open project {i + 1}</button></li>
        ))}
      </ul>
    </div>
    <!-- Credit for the 3D hand and controller (CC BY 4.0): an info button that opens it -->
    <div class="peek-credit">
      <button type="button" class="peek-info" aria-label="3D models info" aria-expanded="false" aria-controls="peek-credit-text">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
      </button>
      <div class="peek-credit-text" id="peek-credit-text" hidden>
        <p>3D models: <a href="https://sketchfab.com/3d-models/vr-hand-a647cce524254c9a96d4244c12811d7a" target="_blank" rel="noopener">VR Hand</a> by RockDutyFree_models, <a href="https://sketchfab.com/3d-models/quest-2-controller-low-mid-and-high-poly-9f02b77cc27148c986315674c7ed106d" target="_blank" rel="noopener">Quest 2 Controller</a> by BlackCube, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a></p>
        <button type="button" class="peek-credit-close" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
        </button>
      </div>
    </div>
  </main>
  <div class="top-shade top-shade--red" aria-hidden="true"></div>
  <div class="bottom-shade bottom-shade--red" aria-hidden="true"></div>

  <dialog class="peek-modal" aria-label="project" tabindex="-1">
    <div class="peek-sheet" aria-hidden="true"></div>
    <button type="button" class="icon-button tip-host peek-close" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      <span class="tip tip--left" aria-hidden="true">Close</span>
    </button>

    {projects.map((p, i) => (
      <div class="peek-slides" data-project={i} hidden>
        {p.images.map((img, n) => (
          <section class="peek-slide">
            <div class="peek-slide-image">
              <Image src={img.src} alt="" widths={[640, 1280, 1920]} sizes="(max-width: 799.98px) 92vw, 58vw" loading="lazy" />
            </div>
            <div class="peek-slide-text">
              {n === 0 ? <h2 class="peek-project">{p.title}</h2> : <p class="peek-project" aria-hidden="true">{p.title}</p>}
              <h3>{img.title}</h3>
              <p>{img.description}</p>
            </div>
          </section>
        ))}
      </div>
    ))}

    <div class="peek-indicator" aria-hidden="true">
      <span class="peek-dots"></span>
      <span class="peek-count"></span>
    </div>
  </dialog>
</BaseLayout>

<script>
  import { initPeek } from '../scripts/peek';
  document.addEventListener('astro:page-load', () => {
    if (document.querySelector('.peek-stage')) initPeek();
  });
</script>

<style>
  /* No page scrolling here: the plane moves instead */
  :global(body[data-page='peek']) {
    overflow: hidden;
    --color-bg: #181a0f; /* dark olive, for this page only (pills, focus rings and the page picture use it too) */
    background: var(--color-bg);
  }

  /* ---------- Title and description: the type and colours of the other pages ---------- */
  /* the title sits as far from the top as on Home (--page-top) */
  .peek-header {
    position: fixed;
    top: var(--page-top);
    right: 0;
    left: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding: 0 var(--gutter);
    text-align: center;
    pointer-events: none; /* the mouse keeps moving the grid underneath */
  }
  .peek-header h1 {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-display-auto);
    color: var(--color-text);
  }
  .peek-intro {
    max-width: 760px;
    font-size: 20px;
    color: var(--color-text);
  }

  /* Credit: an info button at the bottom left (Lucide "info", 14px in a 24px target) that opens the text */
  .peek-credit {
    position: fixed;
    bottom: 16px;
    left: 20px;
    z-index: 2;
  }
  .peek-info {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .peek-info svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .peek-info[aria-expanded='true'],
  .peek-info:focus-visible {
    color: var(--color-accent-2);
  }
  .peek-info:focus-visible {
    outline-offset: 0;
    box-shadow: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .peek-info:hover {
      color: var(--color-accent-2);
    }
  }
  .peek-credit-text {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    width: max-content;
    max-width: min(440px, calc(100vw - 40px));
    padding: 8px 8px 8px 14px;
    border-radius: 14px;
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      rgb(24 24 24 / 0.92);
    box-shadow: inset 0 1px 0 var(--glass-highlight);
    font-size: 12px;
    line-height: 16px;
    color: var(--color-text);
  }
  .peek-credit-text[hidden] {
    display: none;
  }
  /* Close: Lucide "x", 14px in a 20px target */
  .peek-credit-close {
    display: grid;
    flex: none;
    place-items: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }
  .peek-credit-close svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (hover: hover) and (pointer: fine) {
    .peek-credit-close:hover {
      color: var(--color-accent-2);
      background: var(--glass-active);
    }
  }
  .peek-credit-close:focus-visible {
    color: var(--color-accent-2);
    outline-offset: -2px;
    box-shadow: none;
  }
  .peek-credit-text a {
    color: var(--color-accent-2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* the hand only shows with a mouse, and so does its credit */
  @media not ((hover: hover) and (pointer: fine)) {
    .peek-credit {
      display: none;
    }
  }

  /* ---------- The grid (drawn by src/scripts/curve.ts) ---------- */
  .peek-stage {
    position: fixed;
    inset: 0;
    z-index: 1;
  }
  .peek-canvas {
    position: absolute;
    inset: 0;
  }
  .peek-canvas :global(canvas) {
    display: block;
  }
  .peek-canvas:focus {
    outline: none;
  }

  /* Hidden until a button in it has keyboard focus, then a glass list at the bottom left */
  .peek-list {
    position: absolute;
    bottom: 24px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 6px;
    list-style: none;
    clip-path: inset(50%);
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      var(--glass-tint);
    border-radius: 20px;
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
  }
  .peek-list:focus-within {
    clip-path: none;
  }
  .peek-open {
    padding: 8px 14px;
    border: 0;
    border-radius: 14px;
    background: none;
    font: inherit;
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
  }
  .peek-open:focus-visible {
    color: var(--color-accent-2);
    outline-offset: -2px;
    box-shadow: none;
  }

  /* ---------- Modal: iOS-like glass over the sheen ---------- */
  .peek-modal {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    overflow: hidden;
  }
  .peek-modal::backdrop {
    background: rgb(18 18 18 / 0.6);
  }
  .peek-modal:focus {
    outline: none;
  }
  .peek-sheet {
    position: absolute;
    inset: 24px;
    border-radius: 28px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.04)),
      rgb(30 30 34 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.14);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.28),
      inset 0 -1px 0 rgb(255 255 255 / 0.06),
      0 40px 120px rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(28px) saturate(200%) brightness(1.08);
    backdrop-filter: blur(28px) saturate(200%) brightness(1.08);
  }
  .peek-modal[open] .peek-sheet {
    animation: peek-in var(--dur-base) var(--ease-out);
  }
  @keyframes peek-in {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  .peek-close {
    position: absolute;
    top: 48px;
    right: 48px;
    z-index: 2;
  }

  /* One image per screen; scrolling snaps to the next one */
  .peek-slides {
    position: absolute;
    inset: 24px;
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .peek-slides::-webkit-scrollbar {
    display: none;
  }
  .peek-slide {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    height: 100%;
    padding: 48px 104px 48px 48px;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .peek-slide-image :global(img) {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 150px);
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.45);
  }
  .peek-slide-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
  }
  .peek-project {
    margin-bottom: 24px;
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    color: var(--color-accent-2);
  }
  .peek-slide-text h3 {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.1;
    color: var(--color-accent-2);
  }
  .peek-slide-text p:not(.peek-project) {
    color: var(--color-text);
  }

  /* Which image is on screen */
  .peek-indicator {
    position: absolute;
    right: 56px;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    transform: translateY(-50%);
    pointer-events: none;
  }
  .peek-dots {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }
  .peek-dots :global(i) {
    width: 6px;
    height: 6px;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.25);
    transition: width var(--dur-base) var(--ease-out), height var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .peek-dots :global(i.is-on) {
    height: 28px;
    background: var(--color-accent-2);
  }
  .peek-count {
    font-size: 12px;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .peek-modal[open] .peek-sheet {
      animation: none;
    }
  }

  /* ---------- Phones: the modal stacks, image on top ---------- */
  @media (max-width: 799.98px) {
    .peek-sheet,
    .peek-slides {
      inset: 12px;
      border-radius: 22px;
    }
    .peek-close {
      top: 24px;
      right: 24px;
    }
    .peek-slide {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: center;
      gap: 24px;
      padding: 80px 40px 40px 20px;
    }
    .peek-slide-image :global(img) {
      max-height: 52dvh;
    }
    .peek-project {
      margin-bottom: 8px;
      font-size: 40px;
    }
    .peek-slide-text h3 {
      font-size: 24px;
    }
    /* the indicator lies flat along the bottom */
    .peek-indicator {
      top: auto;
      right: 50%;
      bottom: 32px;
      flex-direction: row;
      gap: 16px;
      transform: translateX(50%);
    }
    .peek-dots {
      flex-direction: row;
    }
    .peek-dots :global(i.is-on) {
      width: 28px;
      height: 6px;
    }
    .peek-slide {
      padding: 80px 24px 72px 20px;
    }
  }
</style>
