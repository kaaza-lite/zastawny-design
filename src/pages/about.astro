---
// About: header image, intro, what i do, how i work, tech skills, worked with, location.
// Copy is from the Figma About frames.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import headerImage from '../assets/about-header.png';

const howIWork = [
  'close to engineering',
  'decisions that survive',
  'scoping out loud',
  'design critique into plans',
  'systems over one-offs',
  'accessibility as default',
];

const techSkills = [
  'claude',
  'figma',
  'design systems',
  'multi-brand theming',
  'BPMN',
  'complex & regulated domains',
  'WCAG 2.2 AA',
  'accessibility testing',
];
---

<BaseLayout title="about me">
  <!-- Decorative header image behind the title, fading into the page -->
  <div class="backdrop" aria-hidden="true">
    <Image src={headerImage} alt="" widths={[640, 960, 1280, 1672]} sizes="100vw" loading="eager" />
  </div>

  <main class="page">
    <h1>about me</h1>

    <div class="content">
      <!-- Intro -->
      <section class="intro">
        <div class="name">
          <p class="name-title">tomasz zastawny</p>
          <p class="role">senior product designer</p>
        </div>
        <p class="summary">
          12 years in design, the last 7 of them in fintech, working across UX, UI, and systems. The work has spanned
          institutional infrastructure, retail trading, and emerging-market consumer products. Mostly inside the kind of
          domain where the rules matter and small UI decisions carry real weight.
        </p>
        <Tag dot>open to work</Tag>
      </section>

      <section class="block">
        <h2>what i do</h2>
        <div class="prose">
          <p>
            I'm at my best when the problem is genuinely complex. Regulated workflows, dense data, expert users with no
            patience for friction, and the job is to make all of it feel obvious.
          </p>
          <p>
            A lot of my work has been on the institutional side of fintech: trading infrastructure, fund servicing, the
            screens that don't show up in marketing decks but quietly carry a lot of money.
          </p>
          <p>
            I work close to engineering. I'd rather sit in backlog grooming, pair with engineers on edge cases, and ship
            something concrete than hand off a Figma file and walk away. The craft I care about isn't the pixel-perfect
            mockup. It's the version that survives contact with constraints and still feels considered.
          </p>
        </div>
      </section>

      <section class="block">
        <h2>how i work</h2>
        <ul class="pills">
          {howIWork.map((item) => <li><Tag tone="work">{item}</Tag></li>)}
        </ul>
      </section>

      <!-- Hidden on mobile, as in the Figma mobile frame -->
      <section class="block block--tech">
        <h2>tech skills</h2>
        <ul class="pills">
          {techSkills.map((item) => <li><Tag tone="skill">{item}</Tag></li>)}
        </ul>
      </section>

      <section class="block block--centred">
        <h2>worked with</h2>
        <p>HSBC · Federated Hermes · Calastone · Bamboo · Juicyway · DoubleMap · DrOnline · Helium Health</p>
      </section>

      <section class="block block--centred block--last">
        <h2>location</h2>
        <p class="location">Based in Poland, Schengen Area, EU.</p>
        <!-- Map goes here (760 x 400 in Figma): waiting on the embed decision -->
      </section>
    </div>

    <footer class="footer">
      <p>zastawny ©2026</p>
    </footer>
  </main>
</BaseLayout>

<style>
  /* ---------- Header image ---------- */
  .backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 516px;
    overflow: hidden;
    pointer-events: none;
  }

  .backdrop :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Figma: Fit on desktop and tablet */
  }

  /* Fade from 69% black at the top into the page colour */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.69), var(--color-bg));
  }

  /* ---------- Page ---------- */
  .page {
    position: relative; /* above the header image */
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 202px;
  }

  h1 {
    padding: 0 var(--gutter);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-display-auto);
    letter-spacing: 0;
    text-align: center;
    color: var(--color-text);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: min(760px, calc(100% - 2 * var(--content-gutter)));
    margin-top: 104px;
    padding-bottom: 80px;
  }

  h2,
  .name-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: 0.9;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-text);
  }

  /* ---------- Intro ---------- */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-bottom: 60px;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .role {
    color: var(--color-text);
  }

  .summary {
    width: 100%;
    color: var(--color-text-muted);
  }

  /* ---------- Sections ---------- */
  .block {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 40px 0 60px;
    border-top: 1px dashed var(--color-divider);
    color: var(--color-text-muted);
  }

  .block--centred {
    align-items: center;
    text-align: center;
  }

  .block--last {
    padding-bottom: 0;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location {
    max-width: 520px;
  }

  .footer {
    width: min(760px, calc(100% - 2 * var(--content-gutter)));
    padding-bottom: 60px;
    font-size: var(--text-caption);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1279.98px) {
    .page {
      padding-top: 174px;
    }
    .content,
    .footer {
      width: min(496px, calc(100% - 2 * var(--content-gutter)));
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 799.98px) {
    .backdrop :global(img) {
      object-fit: cover; /* Figma: centred crop on mobile */
    }
    .content {
      margin-top: 56px;
    }
    .block--tech {
      display: none;
    }
    .content,
    .footer {
      width: calc(100% - 2 * var(--content-gutter));
    }
  }
</style>
