---
// About: header image, intro, what i do, how i work, tech skills, worked with, location.
// Copy is from the Figma About frames.
import BaseLayout from '../layouts/BaseLayout.astro';
import Tag from '../components/Tag.astro';
import Experience from '../components/Experience.astro';

const howIWork = [
  'AI-native',
  'Close to engineering',
  'Decisions that survive',
  'Scoping out loud',
  'Design critique into plans',
  'Systems over one-offs',
  'Accessibility as default',
];

const techSkills = [
  'Claude',
  'Figma',
  'Design systems',
  'Multi-brand theming',
  'BPMN',
  'WCAG 2.2 AA',
  'Complex & regulated domains',
  'Accessibility testing',
];
---

<BaseLayout
  title="About | Tomasz Zastawny, Senior Product Designer"
  description="12 years in design, working across UX, UI and systems. From trading infrastructure to consumer apps in emerging markets, I’ve spent that time where the rules matter and small UI decisions carry real weight. Based in Poland, Schengen Area, EU."
>
  <main class="page">
    <h1 data-scramble>About me</h1>

    <div class="content">
      <!-- Intro -->
      <section class="intro">
        <div class="name">
          <p class="name-title">Tomasz Zastawny</p>
          <p class="role">Senior product designer</p>
        </div>
        <p class="summary">
          12 years in design, working across UX, UI and systems. From trading infrastructure to consumer apps in
          emerging markets, I’ve spent that time where the rules matter and small UI decisions carry real weight.
        </p>
        <span class="status-pill" data-pill-group><span data-pill><Tag dot>Open to work</Tag></span></span>
      </section>

      <section class="block">
        <h2>What I do</h2>
        <div class="prose">
          <p>
            I’m at my best when the problem is genuinely complex, whatever the domain. Lately that’s meant
            institutional fintech: trading infrastructure and fund servicing, the screens that quietly carry a lot of
            money.
          </p>
          <p>
            I got there the generalist way, designing investing apps, health platforms, transit tools and VR products,
            including over two years as the only designer at a startup. Getting my head around a new problem fast is
            still my favourite part of the job.
          </p>
          <p>
            I work across the system, the product and the build, so I stay close to engineering. I’d rather pair on
            edge cases and ship than hand off a Figma file and walk away.
          </p>
          <p>
            That’s also how I use AI. It’s fast at execution but weak at judgment: the abstractions, the naming, the
            constraints. That’s the part I own.
          </p>
        </div>
      </section>

      <section class="block experience">
        <h2>Experience</h2>
        <Experience />
      </section>

      <section class="block">
        <h2>How I work</h2>
        <ul class="pills" data-pill-group>
          {howIWork.map((item) => <li data-pill><Tag tone="work">{item}</Tag></li>)}
        </ul>
      </section>

      <section class="block">
        <h2>Tech skills</h2>
        <ul class="pills skill-pills" data-pill-group>
          {techSkills.map((item) => <li data-pill><Tag tone="skill">{item}</Tag></li>)}
        </ul>
      </section>

      <section class="block block--centred">
        <h2>Worked with</h2>
        <p>HSBC · Federated Hermes · Calastone · Bamboo · Juicyway · DoubleMap · DrOnline · Helium Health</p>
      </section>

      <section class="block block--centred block--last">
        <h2>Location</h2>
        <div class="location">
          <p>Based in Poland, Schengen Area, EU.</p>
          <iframe
            class="map"
            src="https://maps.google.com/maps?output=embed&q=Poland&z=5"
            title="Map of Poland"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </section>
    </div>

    <footer class="footer">
      <p>zastawny ©2026</p>
    </footer>
  </main>
</BaseLayout>

<style>
  /* ---------- Page ---------- */
  .page {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 202px;
  }

  h1 {
    padding: 0 var(--gutter);
    font-family: var(--font-display);
    font-size: var(--text-hero);
    line-height: var(--leading-display-auto);
    letter-spacing: 0;
    text-align: center;
    color: var(--color-text);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 30px;
    width: min(760px, calc(100% - 2 * var(--content-gutter)));
    margin-top: 104px;
    padding-bottom: 80px;
  }

  h2,
  .name-title {
    font-family: var(--font-display);
    font-size: var(--text-section);
    line-height: 0.9;
    letter-spacing: 0;
    text-align: center;
    color: var(--color-text);
  }

  /* ---------- Intro ---------- */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-bottom: 60px;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .role {
    color: var(--color-text);
  }

  .summary {
    width: 100%;
    color: var(--color-text-muted);
  }

  /* ---------- Sections ---------- */
  .block {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 40px 0 60px;
    border-top: 1px dashed var(--color-divider);
    color: var(--color-text-muted);
  }

  .block--centred {
    align-items: center;
    text-align: center;
  }

  .block--last {
    padding-bottom: 0;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    --pill-glow: rgb(196 160 235 / 0.4); /* how i work: purple */
  }
  .block:has(.skill-pills) .pills,
  .skill-pills {
    --pill-glow: rgb(120 214 182 / 0.35); /* tech skills: green */
  }

  /* Desktop: a 272px column for the job title, the text takes the rest */
  @media (min-width: 1280px) {
    .experience :global(.job .heading) {
      flex-basis: 272px;
    }
  }

  .location {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
  }

  .location p {
    max-width: 520px;
  }

  /* Google Maps embed, loaded only when it's about to scroll into view */
  .map {
    display: block;
    width: 100%;
    height: 400px;
    border: 0;
    border-radius: var(--radius-card); /* 8px */
    overflow: hidden;
    background: var(--color-surface);
  }

  .footer {
    width: min(760px, calc(100% - 2 * var(--content-gutter)));
    padding-bottom: 60px;
    font-size: var(--text-caption);
    text-align: center;
    color: var(--color-text-muted);
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1279.98px) {
    .page {
      padding-top: 174px;
    }
    .content,
    .footer {
      width: min(496px, calc(100% - 2 * var(--content-gutter)));
    }
  }

  /* ---------- Mobile ---------- */
  @media (max-width: 799.98px) {
    .content {
      margin-top: 56px;
    }
    /* Same 496px column as tablet, so wide phones keep side gutters */
    .content,
    .footer {
      width: min(496px, calc(100% - 2 * var(--content-gutter)));
    }
  }
</style>
