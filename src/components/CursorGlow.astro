---
// A faint datamosh of the page itself, under the mouse (or a finger while swiping).
//
// When the pointer starts moving, the visible page is redrawn into a picture
// (src/scripts/snapshot.ts) and recoloured into the page's colours, like the case
// study cards. Around the pointer, blocks of that picture are dropped in, dragged along
// by the pointer and the same swirling motion as the other datamosh effects, and they
// catch up and disappear when it rests: the same streaks and torn blocks as on the
// cards and heroes, just much quieter.
//
// It sits under the page content (main has z-index 2), so it only shows in the gaps:
// margins, between paragraphs, over the hero image. Blocks right behind text are always
// kept clear, so text contrast never changes.
// On a phone it starts when the screen is touched, keeps going while the finger is down,
// and while scrolling the blocks travel with the page.
// Skipped with reduced motion.
---

<canvas class="cursor-glow" aria-hidden="true"></canvas>

<script>
  import { Mosh, waves, gradientMap, MOSH_FPS } from '../scripts/datamosh';
  import { snapshot } from '../scripts/snapshot';
  import { palettes, type PaletteName } from '../data/palettes';

  const canvas = document.querySelector<HTMLCanvasElement>('.cursor-glow');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const BLOCK = 10;     // block size in CSS pixels
  const REACH = 190;    // px around the pointer where the page gets disturbed
  const OPACITY = 0.5;  // how strongly it shows
  const STILL = 100;    // ms without movement before the pointer stops disturbing the page
  const SETTLE = 1200;  // ms after the last movement before it's all cleared and stopped

  if (canvas && !reduce.matches) {
    canvas.style.opacity = String(OPACITY);
    let mosh: Mosh | null = null;
    let source: HTMLCanvasElement | null = null; // the page, recoloured
    let behindText = new Uint8Array(0);           // 1 where a block is behind text
    let cols = 0;
    let wave = waves();
    let raf = 0;
    let lastFrame = 0;
    let movedAt = -Infinity;
    // The area that may have blocks in it (canvas pixels), so the rest is skipped
    let area = { x0: 0, y0: 0, x1: 0, y1: 0, empty: true };
    const pointer = { x: 0, y: 0, vx: 0, vy: 0, inside: false };
    let touching = false;   // a finger is on the screen
    let textDirty = false;  // text positions changed (scrolling): measure again soon
    let textAt = 0;

    const setup = () => {
      canvas.width = Math.max(1, window.innerWidth);
      canvas.height = Math.max(1, window.innerHeight);
      mosh = new Mosh(canvas, BLOCK);
      source = null;
      area.empty = true;
    };

    // Which blocks have text in front of them
    const findText = () => {
      cols = Math.ceil(canvas.width / BLOCK);
      const rows = Math.ceil(canvas.height / BLOCK);
      behindText = new Uint8Array(cols * rows);
      const range = document.createRange();
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const parent = node.parentElement;
        if (!parent || !node.textContent?.trim() || parent.closest('script, style, .site-nav, .song-player')) continue;
        const b = parent.getBoundingClientRect();
        if (b.bottom < 0 || b.top > window.innerHeight || b.width <= 1) continue;
        range.selectNodeContents(node);
        for (const r of range.getClientRects()) {
          const c0 = Math.max(0, Math.floor((r.left - 4) / BLOCK));
          const c1 = Math.min(cols - 1, Math.floor((r.right + 4) / BLOCK));
          const r0 = Math.max(0, Math.floor((r.top - 4) / BLOCK));
          const r1 = Math.min(rows - 1, Math.floor((r.bottom + 4) / BLOCK));
          for (let y = r0; y <= r1; y++) behindText.fill(1, y * cols + c0, y * cols + c1 + 1);
        }
      }
    };

    // The page as a picture in its colours (made when movement starts, redone after scrolling)
    const ensureSource = () => {
      if (source) return true;
      try {
        const theme = document.body.dataset.theme as PaletteName | undefined;
        source = gradientMap(snapshot(1), palettes[theme ?? 'neutral'] ?? palettes.neutral);
        findText();
        return true;
      } catch {
        return false;
      }
    };

    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (now - lastFrame < 1000 / MOSH_FPS || !mosh) return;
      if (!source && !ensureSource()) return;
      lastFrame = now;
      if (textDirty && now - textAt > 120) {
        findText();
        textDirty = false;
        textAt = now;
      }

      const moving = pointer.inside && (touching || now - movedAt < STILL);
      const px = pointer.x;
      const py = pointer.y;
      if (moving) {
        // the area in play grows to include the pointer's surroundings
        const g = REACH * 1.6;
        area = area.empty
          ? { x0: px - g, y0: py - g, x1: px + g, y1: py + g, empty: false }
          : { x0: Math.min(area.x0, px - g), y0: Math.min(area.y0, py - g), x1: Math.max(area.x1, px + g), y1: Math.max(area.y1, py + g), empty: false };
      }
      const swirl = Math.min(14, Math.hypot(pointer.vx, pointer.vy) * 0.6);
      const catchUp = moving ? 0.03 : 0.25; // resting: the page comes back quickly

      // Close to a moving pointer, blocks of the page drop in, taken from a little way back
      // along the movement, so nearby text and edges smear into the gaps
      if (moving) {
        const ctx = canvas.getContext('2d')!;
        const x0 = Math.max(0, Math.floor((px - REACH) / BLOCK)) * BLOCK;
        const y0 = Math.max(0, Math.floor((py - REACH) / BLOCK)) * BLOCK;
        for (let y = y0; y < Math.min(canvas.height, py + REACH); y += BLOCK) {
          for (let x = x0; x < Math.min(canvas.width, px + REACH); x += BLOCK) {
            if (Math.hypot(x - px, y - py) > REACH || Math.random() > 0.45) continue;
            if (behindText[Math.floor(y / BLOCK) * cols + Math.floor(x / BLOCK)]) continue;
            const [dx, dy, s] = wave(x, y);
            const sx = Math.min(canvas.width - BLOCK, Math.max(0, Math.round(x - pointer.vx * 2 - dx * s * (swirl + 6))));
            const sy = Math.min(canvas.height - BLOCK, Math.max(0, Math.round(y - pointer.vy * 2 - dy * s * (swirl + 6))));
            ctx.clearRect(x, y, BLOCK, BLOCK);
            ctx.drawImage(source, sx, sy, BLOCK, BLOCK, x, y, BLOCK, BLOCK);
          }
        }
      }

      mosh.step(
        (x, y) => {
          // dragged the way the pointer moves, plus the swirling motion field
          const near = Math.max(0, 1 - Math.hypot(x - px, y - py) / (REACH * 1.6)) ** 1.5;
          const [dx, dy, s] = wave(x, y);
          return [pointer.vx * near * 1.4 + dx * s * swirl, pointer.vy * near * 1.4 + dy * s * swirl];
        },
        (x, y) => {
          if (area.empty || x < area.x0 || x > area.x1 || y < area.y0 || y > area.y1) return 'keep';
          if (behindText[Math.floor(y / BLOCK) * cols + Math.floor(x / BLOCK)]) return 'clear';
          if (Math.random() < catchUp) return 'clear';
          return Math.random() < 0.88 ? 'move' : 'keep';
        },
      );

      pointer.vx *= 0.5;
      pointer.vy *= 0.5;

      // Resting long enough: clear everything and stop until the next movement
      if (!moving && !touching && now - movedAt > SETTLE) {
        canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);
        area.empty = true;
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    const moveTo = (x: number, y: number) => {
      // Over a case study tile its own datamosh plays, so the background one clears and waits
      if (document.querySelector('[data-glitch-card]:hover')) {
        cancelAnimationFrame(raf);
        raf = 0;
        pointer.inside = false;
        area.empty = true;
        canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);
        return;
      }
      if (pointer.inside) {
        pointer.vx += x - pointer.x;
        pointer.vy += y - pointer.y;
      }
      pointer.x = x;
      pointer.y = y;
      pointer.inside = true;
      movedAt = performance.now();
      // A fresh picture of the page when there isn't one (first movement, after scrolling or a page change)
      if (!source && !ensureSource()) return;
      if (!raf) {
        wave = waves(); // a new motion field for each new movement
        raf = requestAnimationFrame(frame);
      }
    };

    setup();
    window.addEventListener('resize', setup);
    // After a page change the picture is out of date: start fresh
    const reset = () => {
      cancelAnimationFrame(raf);
      raf = 0;
      source = null;
      area.empty = true;
      canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);
    };
    document.addEventListener('astro:after-swap', reset);

    // Scrolling: the blocks and the picture travel with the page; a fresh picture once it stops
    let lastScroll = window.scrollY;
    let scrollIdle = 0;
    const shift = (c: HTMLCanvasElement, dy: number) => {
      const g = c.getContext('2d')!;
      g.globalCompositeOperation = 'copy';
      g.drawImage(c, 0, -dy);
      g.globalCompositeOperation = 'source-over';
    };
    window.addEventListener('scroll', () => {
      const dy = Math.round(window.scrollY - lastScroll);
      lastScroll = window.scrollY;
      if (!dy) return;
      if (source) shift(source, dy);
      shift(canvas, dy);
      area.y0 -= dy;
      area.y1 -= dy;
      textDirty = true;
      clearTimeout(scrollIdle);
      scrollIdle = window.setTimeout(() => {
        source = null; // taken again on the next frame
      }, 200);
    }, { passive: true });

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse') moveTo(e.clientX, e.clientY);
    });
    document.documentElement.addEventListener('pointerleave', () => {
      pointer.inside = false;
    });
    // Touch: starts when the screen is touched, follows the finger, keeps going while it's down
    document.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      if (!t) return;
      touching = true;
      pointer.inside = false; // no speed from the jump to a new spot
      moveTo(t.clientX, t.clientY);
    }, { passive: true });
    document.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      if (t) moveTo(t.clientX, t.clientY);
    }, { passive: true });
    const lift = () => {
      touching = false;
      pointer.inside = false;
      movedAt = performance.now();
    };
    document.addEventListener('touchend', lift, { passive: true });
    document.addEventListener('touchcancel', lift, { passive: true });
  }
</script>

<style>
  /* Full window, above the background and the case study hero image (z-index 1),
     under the content */
  .cursor-glow {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* The page content sits above it */
  :global(body > main) {
    position: relative;
    z-index: 2;
  }
</style>
