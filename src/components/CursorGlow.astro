---
// A datamosh glow under the mouse. The page is covered by a grid of square blocks;
// blocks near the cursor light up in the page's colour (--focus-ring) with uneven,
// noisy brightness, like compression artifacts. When the mouse moves, the lit blocks
// are dragged along with it and by the same swirling motion as the other datamosh
// effects, rows tear sideways now and then, and a few blocks freeze for a moment
// before snapping off, so the trail smears and breaks up as it fades. Brightness comes in a few hard steps, like a video
// codec running out of bits, and it updates at a stuttering 24fps.
//
// It sits above the page background and the case study hero image, but under the
// content (main has z-index 2). Blocks right behind text stay at --glow-strength, the
// most that keeps grey text at 4.5:1; everywhere else the glow can go up to STRONG.
// Only while the mouse or a finger is moving: it fades out when they rest.
// On a phone it follows the finger while swiping; scrolling drags the lit blocks along
// with the page (momentum included), so the background moves with the swipe.
// Skipped with reduced motion.
---

<canvas class="cursor-glow" aria-hidden="true"></canvas>

<script>
  import { waves } from '../scripts/datamosh';
  const canvas = document.querySelector<HTMLCanvasElement>('.cursor-glow');
  const mouse = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const BLOCK = 14;    // block size in CSS pixels
  const RADIUS = 9;    // glow radius, in blocks
  const LEVELS = 4;    // brightness steps
  const FADE = 0.86;   // how much of the glow is left each frame
  const FPS = 24;
  const STILL = 100;   // ms without movement before the cursor stops lighting blocks
  const STRONG = 0.1;  // brightest glow away from text (share of the page colour)

  if (canvas && !reduce.matches) {
    const ctx = canvas.getContext('2d')!;
    let cols = 0;
    let rows = 0;
    let field = new Float32Array(0); // brightness of each block, 0 to 1
    let nearText = new Uint8Array(0);  // 1 where a block is behind text
    let next = new Float32Array(0);
    let frozen = new Uint8Array(0);   // frames a stuck block keeps its brightness before snapping off
    let wave = waves();
    let image: ImageData;
    let colour = [255, 255, 255];
    let strength = 0.03;

    // Pointer in blocks, and how far it moved since the last frame
    const pointer = { x: -100, y: -100, vx: 0, vy: 0, inside: false };
    let raf = 0;
    let last = 0;
    let movedAt = -Infinity;

    const setup = () => {
      cols = Math.max(1, Math.ceil(window.innerWidth / BLOCK)); // at least 1, even in a hidden tab
      rows = Math.max(1, Math.ceil(window.innerHeight / BLOCK));
      canvas.width = cols;
      canvas.height = rows;
      field = new Float32Array(cols * rows);
      next = new Float32Array(cols * rows);
      frozen = new Uint8Array(cols * rows);
      image = ctx.createImageData(cols, rows);
      nearText = new Uint8Array(cols * rows);
      findText();
      const style = getComputedStyle(document.body);
      const hex = style.getPropertyValue('--focus-ring').trim();
      colour = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
      strength = parseFloat(style.getPropertyValue('--glow-strength')) / 100 || 0.03;
    };

    // Which blocks have text in front of them (redone on scroll and resize)
    const findText = () => {
      nearText.fill(0);
      const range = document.createRange();
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
        const parent = node.parentElement;
        if (!parent || !node.textContent?.trim() || parent.closest('script, style, .site-nav')) continue;
        const box = parent.getBoundingClientRect();
        if (box.bottom < 0 || box.top > window.innerHeight || box.width === 0) continue;
        range.selectNodeContents(node);
        for (const r of range.getClientRects()) {
          const c0 = Math.max(0, Math.floor((r.left - 2) / BLOCK));
          const c1 = Math.min(cols - 1, Math.floor((r.right + 2) / BLOCK));
          const r0 = Math.max(0, Math.floor((r.top - 2) / BLOCK));
          const r1 = Math.min(rows - 1, Math.floor((r.bottom + 2) / BLOCK));
          for (let y = r0; y <= r1; y++) nearText.fill(1, y * cols + c0, y * cols + c1 + 1);
        }
      }
    };
    let textQueued = false;
    let lastScroll = window.scrollY;
    let scrolled = 0; // blocks the page has scrolled since the last frame
    window.addEventListener('scroll', () => {
      if (raf) scrolled += (window.scrollY - lastScroll) / BLOCK;
      lastScroll = window.scrollY;
      if (textQueued) return;
      textQueued = true;
      requestAnimationFrame(() => {
        textQueued = false;
        findText();
      });
    }, { passive: true });

    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      if (now - last < 1000 / FPS) return;
      last = now;

      // Smear: every block takes the brightness of the block it was dragged from,
      // following the pointer and moving with the page when it scrolls
      const scroll = Math.trunc(scrolled);
      scrolled -= scroll;
      const dx = Math.round(pointer.vx);
      const dy = Math.round(pointer.vy) - scroll;
      let alive = false;
      const swirl = Math.min(2, Math.hypot(pointer.vx, pointer.vy) * 0.5); // blocks of extra drag while moving
      for (let r = 0; r < rows; r++) {
        // now and then a whole row tears sideways
        const tear = Math.random() < 0.05 ? Math.round((Math.random() - 0.5) * 6) : 0;
        for (let c = 0; c < cols; c++) {
          const i = r * cols + c;
          // a frozen block holds its brightness, then snaps off
          if (frozen[i] > 0) {
            frozen[i]--;
            next[i] = frozen[i] ? field[i] : 0;
            continue;
          }
          // moved by the pointer plus the swirling motion field; some blocks stick, so the trail tears
          const [wx, wy, strength] = wave(c * BLOCK, r * BLOCK);
          const stuck = Math.random() < 0.25;
          const mx = stuck ? 0 : Math.round(dx + tear + wx * strength * swirl);
          const my = stuck ? 0 : Math.round(dy + wy * strength * swirl);
          const sc = Math.min(cols - 1, Math.max(0, c - mx));
          const sr = Math.min(rows - 1, Math.max(0, r - my));
          next[i] = field[sr * cols + sc] * FADE;
          if (next[i] > 0.3 && Math.random() < 0.02) frozen[i] = 4 + Math.floor(Math.random() * 8);
        }
      }
      // Light up the blocks around the cursor, with a ragged edge (only while it moves)
      const moving = pointer.inside && now - movedAt < STILL;
      if (moving) {
        const x0 = Math.max(0, Math.floor(pointer.x - RADIUS));
        const x1 = Math.min(cols - 1, Math.ceil(pointer.x + RADIUS));
        const y0 = Math.max(0, Math.floor(pointer.y - RADIUS));
        const y1 = Math.min(rows - 1, Math.ceil(pointer.y + RADIUS));
        for (let r = y0; r <= y1; r++) {
          for (let c = x0; c <= x1; c++) {
            const d = Math.hypot(c + 0.5 - pointer.x, r + 0.5 - pointer.y) / RADIUS;
            // uneven brightness per block, like compression noise
            const light = Math.max(0, 1 - d - Math.random() * 0.25) * (0.55 + Math.random() * 0.45);
            const i = r * cols + c;
            next[i] = Math.max(next[i], light);
          }
        }
      }
      [field, next] = [next, field];

      // Draw: brightness in hard steps, at most --glow-strength of the page colour
      const d = image.data;
      for (let i = 0; i < field.length; i++) {
        const level = Math.floor(field[i] * LEVELS) / LEVELS;
        if (level > 0) alive = true;
        d[i * 4] = colour[0];
        d[i * 4 + 1] = colour[1];
        d[i * 4 + 2] = colour[2];
        d[i * 4 + 3] = Math.round(level * (nearText[i] ? strength : STRONG) * 255);
      }
      ctx.putImageData(image, 0, 0);

      pointer.vx *= 0.5;
      pointer.vy *= 0.5;
      if (!alive && !moving) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
    };

    setup();
    window.addEventListener('resize', setup);
    document.addEventListener('astro:after-swap', setup); // the next page's colour and text

    document.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || !mouse.matches) return;
      const x = e.clientX / BLOCK;
      const y = e.clientY / BLOCK;
      if (pointer.inside) {
        pointer.vx += x - pointer.x;
        pointer.vy += y - pointer.y;
      }
      pointer.x = x;
      pointer.y = y;
      pointer.inside = true;
      movedAt = performance.now();
      if (!raf) {
        wave = waves(); // a new motion field for each new movement
        raf = requestAnimationFrame(frame);
      }
    });
    document.documentElement.addEventListener('pointerleave', () => {
      pointer.inside = false;
    });

    // Touch: follow the finger while it swipes (the page scrolling does the dragging)
    const touch = (e: TouchEvent, moved: boolean) => {
      const t = e.touches[0];
      if (!t) return;
      pointer.x = t.clientX / BLOCK;
      pointer.y = t.clientY / BLOCK;
      pointer.inside = true;
      if (!moved) return;
      movedAt = performance.now();
      if (!raf) {
        lastScroll = window.scrollY;
        raf = requestAnimationFrame(frame);
      }
    };
    document.addEventListener('touchstart', (e) => touch(e, false), { passive: true });
    document.addEventListener('touchmove', (e) => touch(e, true), { passive: true });
    const lift = () => {
      pointer.inside = false;
    };
    document.addEventListener('touchend', lift, { passive: true });
    document.addEventListener('touchcancel', lift, { passive: true });
  }
</script>

<style>
  /* One canvas pixel per block, stretched to the window with hard pixel edges.
     Above the background and the case study hero image (z-index 1), under the content. */
  .cursor-glow {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    pointer-events: none;
  }
  /* The page content sits above the glow */
  :global(body > main) {
    position: relative;
    z-index: 2;
  }
</style>
