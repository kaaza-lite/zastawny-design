---
// A wide image in a case study: 962px on desktop, 650px on tablet, the column width on mobile.
// Under it on the right, a glass full screen button, like the slider's (see Lightbox.astro).
// `ratio` (width / height) forces a frame shape like Figma's "Fill"; leave it out to use the
// image's own proportions.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: number;
  rounded?: boolean;
}

const { src, alt, ratio = src.width / src.height, rounded = false } = Astro.props;

// Large version for the full-size preview
const full = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' });
---

<figure class:list={['case-wide', 'media', { rounded }]}>
  <div class="frame" style={`aspect-ratio: ${ratio}`}>
    <Image src={src} alt={alt} widths={[600, 962, 1300, 1924]} sizes="(max-width: 799.98px) calc(100vw - 24px), (max-width: 1279.98px) 650px, 962px" />
  </div>
  <div class="glass-pill">
    <button
      type="button"
      class="pill-button tip-host"
      data-zoom-src={full.src}
      data-zoom-alt={alt}
      aria-label="View full screen"
      aria-haspopup="dialog"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6" /><path d="M9 21H3v-6" /><path d="M21 3l-7 7" /><path d="M3 21l7-7" /></svg>
      <span class="tip" aria-hidden="true">Full screen</span>
    </button>
  </div>
</figure>

<style>
  .media {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .media .glass-pill {
    align-self: flex-end;
  }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rounded :global(img) {
    border-radius: var(--radius-card);
  }
</style>
