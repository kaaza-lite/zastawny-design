---
// A wide image in a case study: 962px on desktop, 650px on tablet, the column width on mobile.
// `ratio` keeps the Figma frame's proportions (width / height); the image fills it like Figma's "Fill".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio: number;
  rounded?: boolean;
}

const { src, alt, ratio, rounded = false } = Astro.props;
---

<figure class:list={['case-wide', 'media', { rounded }]} style={`aspect-ratio: ${ratio}`}>
  <Image src={src} alt={alt} widths={[600, 962, 1300, 1924]} sizes="(max-width: 799.98px) calc(100vw - 24px), (max-width: 1279.98px) 650px, 962px" />
</figure>

<style>
  .media {
    overflow: hidden;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rounded {
    border-radius: var(--radius-card);
  }
</style>
