---
// Image carousel (Figma: "calas slider"), widened to the 962px media width.
// Pass `slides` when the images are ready; until then it shows grey placeholder slides.
// Swipe or scroll sideways, or use the arrow buttons. Dots show the position.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slides?: { src: ImageMetadata; alt: string }[];
  placeholders?: number;
}

const { slides = [], placeholders = 5 } = Astro.props;
const count = slides.length || placeholders;
---

<div class="case-wide carousel" data-carousel>
  <div class="track" tabindex="0">
    {slides.length
      ? slides.map((s) => (
          <div class="slide">
            <Image src={s.src} alt={s.alt} widths={[600, 962, 1924]} sizes="(max-width: 799.98px) calc(100vw - 24px), (max-width: 1279.98px) 650px, 962px" />
          </div>
        ))
      : Array.from({ length: count }, () => <div class="slide slide--placeholder" aria-hidden="true" />)}
  </div>
  <div class="controls">
    <div class="dots" aria-hidden="true">
      {Array.from({ length: count }, (_, i) => <span class:list={['dot', { 'is-active': i === 0 }]} />)}
    </div>
    <div class="arrows">
      <button type="button" class="arrow" data-dir="-1" aria-label="Previous image">↫</button>
      <button type="button" class="arrow" data-dir="1" aria-label="Next image">↬</button>
    </div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
    const count = dots.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);

    const show = (i: number) => {
      const index = (i + count) % count; // wrap around at the ends
      track.scrollTo({ left: index * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    for (const btn of root.querySelectorAll<HTMLButtonElement>('.arrow')) {
      btn.addEventListener('click', () => show(current() + Number(btn.dataset.dir)));
    }

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current() - 1); }
    });

    // Keep the dots in step with swipes and scrolling
    track.addEventListener('scroll', () => {
      const i = current();
      dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
    }, { passive: true });
  }
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 748 / 437; /* Figma slide proportions */
  }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slide--placeholder {
    background: #d9d9d9;
  }

  .controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 44px;
  }

  .dots {
    position: absolute;
    left: 50%;
    display: flex;
    gap: 4px;
    transform: translateX(-50%);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 48px;
    background: #ffffff;
  }
  .dot.is-active {
    width: 24px;
    background: var(--theme-accent, var(--color-accent-3));
  }

  .arrows {
    display: flex;
    gap: 16px;
  }
  .arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--theme-accent, var(--color-accent-3));
    font: inherit;
    color: var(--color-text-paragraph);
    cursor: pointer;
  }
</style>
