---
// Image carousel (Figma: "calas slider"), widened to the 962px media width.
// Pass `slides` when the images are ready; until then it shows grey placeholder slides.
// Swipe or scroll sideways, or use the arrow buttons. Dots show the position.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slides?: { src: ImageMetadata; alt: string }[];
  placeholders?: number;
}

const { slides = [], placeholders = 5 } = Astro.props;
const count = slides.length || placeholders;
---

<div class="case-wide carousel" data-carousel>
  <div class="track" tabindex="0">
    {slides.length
      ? slides.map((s) => (
          <div class="slide">
            <Image src={s.src} alt={s.alt} widths={[600, 962, 1924]} sizes="(max-width: 799.98px) calc(100vw - 24px), (max-width: 1279.98px) 650px, 962px" />
          </div>
        ))
      : Array.from({ length: count }, () => <div class="slide slide--placeholder" aria-hidden="true" />)}
  </div>
  <div class="controls">
    <div class="dots" aria-hidden="true" style={`--count: ${count}`}>
      {Array.from({ length: count }, () => <span class="dot"><span class="dot-fill" /></span>)}
    </div>
    <div class="arrows">
      <button type="button" class="arrow" data-dir="-1" aria-label="previous image">↫<span class="tip" aria-hidden="true">previous image</span></button>
      <button type="button" class="arrow" data-dir="1" aria-label="next image">↬<span class="tip" aria-hidden="true">next image</span></button>
    </div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('.track')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];
    const count = dots.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);

    const show = (i: number) => {
      const index = (i + count) % count; // wrap around at the ends
      track.scrollTo({ left: index * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    for (const btn of root.querySelectorAll<HTMLButtonElement>('.arrow')) {
      btn.addEventListener('click', () => show(current() + Number(btn.dataset.dir)));
    }

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current() - 1); }
    });

    // Dots follow the scroll position continuously: the active line flows into the
    // next dot as the slide moves (each dot's length and colour track how close it is).
    const DOT = 8, LINE = 24, GAP = 4;
    let frame = 0;
    const paint = () => {
      frame = 0;
      const p = track.scrollLeft / (track.clientWidth || 1); // 0 .. count-1, fractional mid-swipe
      let x = 0;
      dots.forEach((dot, i) => {
        const near = Math.max(0, 1 - Math.abs(p - i)); // 1 on the current slide, 0 two slides away
        const w = DOT + (LINE - DOT) * near;
        dot.style.transform = `translateX(${x}px)`;
        dot.style.clipPath = `inset(0 ${LINE - w}px 0 0 round ${DOT / 2}px)`;
        dot.style.setProperty('--near', String(near));
        x += w + GAP;
      });
    };
    track.addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(paint); }, { passive: true });
    paint();
  }
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 748 / 437; /* Figma slide proportions */
  }
  .slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slide--placeholder {
    background: #d9d9d9;
  }

  .controls {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-height: 44px;
  }

  /* Dots row: one 24px line and 8px dots with 4px gaps (positioned by the script) */
  .dots {
    position: absolute;
    left: 50%;
    width: calc(24px + (var(--count) - 1) * 12px);
    height: 8px;
    transform: translateX(-50%);
  }
  .dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 24px;
    height: 8px;
    background: #ffffff;
    clip-path: inset(0 16px 0 0 round 4px);
  }
  /* Accent colour fades in as the dot becomes the active line */
  .dot-fill {
    position: absolute;
    inset: 0;
    background: var(--theme-accent, var(--color-accent-3));
    opacity: var(--near, 0);
  }

  .arrows {
    display: flex;
    gap: 16px;
  }
  .arrow {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--theme-accent, var(--color-accent-3));
    font: inherit;
    color: var(--color-text-paragraph);
    cursor: pointer;
  }

  /* Tooltip above each arrow, on mouse hover and keyboard focus. Same type size as the body text. */
  .tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    padding: 6px 12px;
    background: var(--glass-tint);
    border: 1px solid var(--glass-rim);
    border-radius: var(--radius-pill);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    backdrop-filter: blur(18px) saturate(180%);
    font-family: var(--font-body);
    font-weight: 300;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    color: var(--color-text);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .arrow:hover .tip {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }
  .arrow:focus-visible .tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  /* The last arrow sits at the right edge: anchor its tooltip to the right so it never runs off screen */
  .arrow:last-child .tip {
    left: auto;
    right: 0;
    transform: translateY(4px);
  }
  @media (hover: hover) and (pointer: fine) {
    .arrow:last-child:hover .tip {
      transform: none;
    }
  }
  .arrow:last-child:focus-visible .tip {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .tip {
      transition: opacity var(--dur-fast) linear;
    }
  }
</style>
