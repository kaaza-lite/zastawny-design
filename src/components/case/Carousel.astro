---
// Image slider on the case studies, at the 962px media width.
// The image on top; under it the caption on the left and a glass control pill on the right:
// previous, the dots, next, and full screen. Slides crossfade (no fade with reduced motion),
// loop at both ends, and can be swiped or moved with the arrow keys. The frame keeps the
// tallest slide's proportions, so the block's height never changes between slides.
// Full screen opens from the image or the expand button, with the same controls; it closes
// with Escape, the close button or a click outside the image.
// Icons are Lucide (lucide.dev, ISC licence), as in the nav: chevron-left, chevron-right,
// maximize-2 and x.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slides?: { src: ImageMetadata; alt: string; caption?: string }[];
  placeholders?: number;
}

const { slides = [], placeholders = 5 } = Astro.props;
const count = slides.length || placeholders;

// Frame shape: the tallest slide's proportions, so every image shows whole (none are cropped)
const ratio = slides.length ? Math.min(...slides.map((s) => s.src.width / s.src.height)) : 748 / 437;

// Large version of each slide for full screen
const fulls = await Promise.all(slides.map((s) => getImage({ src: s.src, width: Math.min(s.src.width, 2400), format: 'webp' })));
---

<div class="case-wide carousel" data-carousel role="region" aria-roledescription="carousel" aria-label="Image slider">
  <div class="stage" style={`--ratio: ${ratio}`}>
    {slides.length
      ? slides.map((s, i) => (
          <div
            class:list={['slide', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${count}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i !== 0}
            data-caption={s.caption ?? ''}
            data-full={fulls[i].src}
            data-alt={s.alt}
          >
            <button type="button" class="slide-frame" style={`--r: ${s.src.width / s.src.height}`} aria-label={`View image ${i + 1} full screen`} aria-haspopup="dialog">
              <Image
                src={s.src}
                alt={s.alt}
                widths={[600, 962, 1300, 1924]}
                sizes="(max-width: 799.98px) calc(100vw - 24px), (max-width: 1279.98px) 650px, 962px"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </button>
          </div>
        ))
      : Array.from({ length: count }, (_, i) => <div class:list={['slide', 'slide--placeholder', { 'is-active': i === 0 }]} aria-hidden="true" />)}
  </div>

  <div class="controls">
    <p class="caption" aria-live="polite">{slides[0]?.caption ?? ''}</p>
    <div class="glass-pill pill">
      <button type="button" class="pill-button tip-host" data-step="-1" aria-label="Previous image">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        <span class="tip" aria-hidden="true">Previous</span>
      </button>
      <div class="dots">
        {Array.from({ length: count }, (_, i) => (
          <button type="button" class="dot" data-go={i} aria-label={`Image ${i + 1} of ${count}`} aria-current={i === 0 ? 'true' : undefined}>
            <span aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <button type="button" class="pill-button tip-host" data-step="1" aria-label="Next image">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        <span class="tip" aria-hidden="true">Next</span>
      </button>
      {slides.length > 0 && (
        <>
          <span class="divider" aria-hidden="true"></span>
          <button type="button" class="pill-button tip-host" data-expand aria-label="View full screen" aria-haspopup="dialog">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6" /><path d="M9 21H3v-6" /><path d="M21 3l-7 7" /><path d="M3 21l7-7" /></svg>
            <span class="tip tip--end" aria-hidden="true">Full screen</span>
          </button>
        </>
      )}
    </div>
  </div>

  {slides.length > 0 && (
    <dialog class="viewer" aria-label="Image viewer">
      <button type="button" class="icon-button tip-host viewer-close" data-close aria-label="Close full screen">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
        <span class="tip tip--left" aria-hidden="true">Close</span>
      </button>
      <div class="viewer-body">
        <img class="viewer-image" alt="" />
        <div class="controls viewer-controls">
          <p class="caption" aria-live="polite"></p>
          <div class="glass-pill pill">
            <button type="button" class="pill-button tip-host" data-step="-1" aria-label="Previous image">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
              <span class="tip" aria-hidden="true">Previous</span>
            </button>
            <div class="dots">
              {Array.from({ length: count }, (_, i) => (
                <button type="button" class="dot" data-go={i} aria-label={`Image ${i + 1} of ${count}`} aria-current={i === 0 ? 'true' : undefined}>
                  <span aria-hidden="true"></span>
                </button>
              ))}
            </div>
            <button type="button" class="pill-button tip-host" data-step="1" aria-label="Next image">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              <span class="tip tip--end" aria-hidden="true">Next</span>
            </button>
          </div>
        </div>
      </div>
    </dialog>
  )}
</div>

<script>
  const SWIPE = 40; // px sideways before a swipe counts

  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
      const slides = [...root.querySelectorAll<HTMLElement>('.stage .slide')];
      const count = slides.length;
      const viewer = root.querySelector<HTMLDialogElement>('.viewer');
      const viewerImage = viewer?.querySelector<HTMLImageElement>('.viewer-image');
      let index = 0;
      let swiped = false;
      let opener: HTMLElement | null = null; // Safari doesn't focus clicked buttons, so remember it ourselves

      // Start loading the slide after the current one, so it's ready when it's needed
      const preload = (i: number) => {
        const slide = slides[(i + count) % count];
        const img = slide?.querySelector('img');
        if (img && img.loading === 'lazy') img.loading = 'eager';
        if (viewer?.open && slide?.dataset.full) new Image().src = slide.dataset.full;
      };

      const show = (i: number) => {
        index = (i + count) % count; // loops at both ends
        slides.forEach((slide, n) => {
          const on = n === index;
          slide.classList.toggle('is-active', on);
          slide.inert = !on;
          if (on) slide.removeAttribute('aria-hidden');
          else slide.setAttribute('aria-hidden', 'true');
        });
        for (const dots of root.querySelectorAll<HTMLElement>('.dots')) {
          dots.querySelectorAll<HTMLElement>('.dot').forEach((d, n) => {
            if (n === index) d.setAttribute('aria-current', 'true');
            else d.removeAttribute('aria-current');
          });
        }
        const caption = slides[index]?.dataset.caption ?? '';
        for (const c of root.querySelectorAll<HTMLElement>('.caption')) c.textContent = caption;
        if (viewer?.open && viewerImage) {
          viewerImage.src = slides[index].dataset.full ?? '';
          viewerImage.alt = slides[index].dataset.alt ?? '';
        }
        preload(index + 1);
      };

      const openViewer = (from: HTMLElement) => {
        if (!viewer || !viewerImage) return;
        opener = from;
        viewer.showModal();
        document.documentElement.classList.add('is-previewing'); // stop the page scrolling behind
        show(index);
      };

      // The same controls in the page and in full screen
      root.addEventListener('click', (e) => {
        const t = (e.target as Element).closest<HTMLElement>('button');
        if (!t || !root.contains(t)) return;
        if (t.dataset.step) show(index + Number(t.dataset.step));
        else if (t.dataset.go) show(Number(t.dataset.go));
        else if ('expand' in t.dataset || t.classList.contains('slide-frame')) {
          if (!swiped) openViewer(t);
        } else if ('close' in t.dataset) viewer?.close();
      });

      // Arrow keys move the slider while focus is in it (or in full screen)
      root.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      });

      // Swipe sideways on the image (in the page or in full screen)
      let startX = 0;
      let startY = 0;
      for (const area of [root.querySelector<HTMLElement>('.stage'), viewerImage]) {
        if (!area) continue;
        area.addEventListener('pointerdown', (e) => {
          startX = e.clientX;
          startY = e.clientY;
          swiped = false;
        });
        area.addEventListener('pointerup', (e) => {
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          if (Math.abs(dx) > SWIPE && Math.abs(dx) > Math.abs(dy)) {
            swiped = true; // so the tap that ends a swipe doesn't also open full screen
            show(index + (dx < 0 ? 1 : -1));
            setTimeout(() => (swiped = false), 0);
          }
        });
      }

      if (viewer) {
        // A click outside the image and the controls closes full screen
        viewer.addEventListener('click', (e) => {
          const t = e.target as Element;
          if (t === viewer || t.classList.contains('viewer-body')) viewer.close();
        });
        viewer.addEventListener('close', () => {
          document.documentElement.classList.remove('is-previewing');
          opener?.focus({ preventScroll: true }); // back to what opened it
        });
      }

      preload(1);
    }
  });
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* All slides stacked in one frame with the tallest slide's proportions: the height never jumps */
  .stage {
    position: relative;
    aspect-ratio: var(--ratio);
    touch-action: pan-y; /* sideways drags are swipes, up and down still scrolls the page */
  }

  .slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    container-type: size;
    opacity: 0;
    transition: opacity 400ms var(--ease-in-out);
  }
  .slide.is-active {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }

  /* The image's own box inside the slide, a button that opens full screen */
  .slide-frame {
    display: block;
    width: min(100cqw, 100cqh * var(--r));
    aspect-ratio: var(--r);
    padding: 0;
    border: 0;
    border-radius: var(--radius-card);
    background: none;
    cursor: zoom-in;
  }
  .slide-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-card);
    -webkit-user-drag: none;
    user-select: none;
  }
  .slide-frame:focus-visible {
    outline-offset: 4px;
  }
  .slide--placeholder {
    background: #d9d9d9;
    border-radius: var(--radius-card);
  }

  /* Caption on the left, the control pill on the right */
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .caption {
    color: var(--color-text);
  }

  /* The control pill (.glass-pill and .pill-button are in global.css) */
  .pill {
    margin-left: auto;
  }
  .dot:focus-visible {
    outline-offset: -2px;
    box-shadow: none;
  }

  /* Dots: 6px white, the current one a 24px bar in the case study's accent.
     Each sits in a 24 × 44px button, so it's easy to tap. */
  .dots {
    display: flex;
    align-items: center;
  }
  .dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    cursor: pointer;
  }
  .dot span {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-2);
    transition:
      width var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }
  .dot[aria-current='true'] {
    width: 32px;
  }
  .dot[aria-current='true'] span {
    width: 24px;
    background: var(--theme-accent, var(--color-accent-3));
  }
  @media (hover: hover) and (pointer: fine) {
    .dot:not([aria-current='true']):hover span {
      background: rgb(255 255 255 / 0.6);
    }
  }

  .divider {
    width: 1px;
    height: 24px;
    margin: 0 6px;
    background: rgb(255 255 255 / 0.18);
  }

  /* ---------- Full screen ---------- */
  .viewer {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .viewer[open] {
    display: grid;
  }
  .viewer::backdrop {
    background: rgb(0 0 0 / 0.86);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .viewer-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 80px 24px 32px;
  }
  .viewer-image {
    max-width: 100%;
    max-height: calc(100vh - 200px);
    object-fit: contain;
    border-radius: var(--radius-card);
    touch-action: pan-y;
    -webkit-user-drag: none;
    user-select: none;
  }
  .viewer-controls {
    width: min(100%, 962px);
  }
  .viewer-close {
    position: fixed;
    top: 24px;
    right: 24px;
  }
  .viewer[open]::backdrop {
    animation: viewer-fade var(--dur-base) var(--ease-out);
  }
  .viewer[open] .viewer-body {
    animation: viewer-in var(--dur-base) var(--ease-out);
  }
  @keyframes viewer-fade {
    from { opacity: 0; }
  }
  @keyframes viewer-in {
    from { opacity: 0; transform: scale(0.98); }
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer[open] .viewer-body {
      animation: viewer-fade var(--dur-fast) linear;
    }
  }

  /* Phones: the caption on its own line above the pill */
  @media (max-width: 799.98px) {
    .controls {
      flex-wrap: wrap;
      row-gap: 12px;
    }
    .caption {
      flex: 1 0 100%;
    }
    .caption:empty {
      display: none;
    }
    .viewer-body {
      padding: 72px 12px 24px;
    }
    .viewer-close {
      top: 16px;
      right: 16px;
    }
  }
</style>
