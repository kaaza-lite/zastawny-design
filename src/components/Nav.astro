---
// Floating glass pill at the top of the screen.
// Same items and labels as the Figma nav. "works" is the Home page.
//
// The active item sits on a light fill that slides from the previous page's item
// to the current one on page load (transform only).

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const caseStudies = ['/calastone', '/bamboo', '/juicyway'];
// Home and the case studies highlight "works"; About highlights "about"
const active = path === '/' || caseStudies.includes(path) ? 'works' : path === '/about' ? 'about' : null;
---

<header class="site-nav">
  <nav class="nav">
    <a class="logo" href="/">
      <span class="logo-full">zastawny</span>
      <span class="logo-short" aria-hidden="true">z</span>
    </a>
    <div class="links">
      <span class="highlight" aria-hidden="true"></span>
      <a href="/" data-key="works" aria-current={active === 'works' ? 'page' : undefined}>works</a>
      <a href="/about" data-key="about" aria-current={active === 'about' ? 'page' : undefined}>about</a>
      <a href="https://www.linkedin.com/in/zastawny/" target="_blank" rel="noopener" class="external">
        <span class="external-label">linkedin</span><span class="external-arrow" aria-hidden="true">⇗</span>
      </a>
    </div>
  </nav>
</header>

<script>
  // Slide the glass pill from the item that was active on the previous page.
  const STORAGE_KEY = 'nav-active';

  function setup() {
    const links = document.querySelector<HTMLElement>('.site-nav .links');
    const pill = links?.querySelector<HTMLElement>('.highlight');
    if (!links || !pill) return;

    const current = links.querySelector<HTMLElement>('a[aria-current="page"]');
    if (!current) {
      pill.hidden = true;
      return;
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Put the pill exactly behind a link
    const placeOn = (link: HTMLElement) => {
      pill.style.left = `${link.offsetLeft}px`;
      pill.style.width = `${link.offsetWidth}px`;
    };

    let previous: HTMLElement | null = null;
    try {
      const key = sessionStorage.getItem(STORAGE_KEY);
      if (key && key !== current.dataset.key) {
        previous = links.querySelector<HTMLElement>(`a[data-key="${key}"]`);
      }
      sessionStorage.setItem(STORAGE_KEY, current.dataset.key ?? '');
    } catch {}

    placeOn(current);
    links.classList.add('js-ready');

    // Slide: start transformed onto the previous link, then animate to no transform
    if (previous && !reduceMotion) {
      const dx = previous.offsetLeft - current.offsetLeft;
      const sx = previous.offsetWidth / current.offsetWidth;
      pill.style.transform = `translateX(${dx}px) scaleX(${sx})`;
      pill.getBoundingClientRect(); // commit the start position
      pill.classList.add('is-animated');
      pill.style.transform = '';
      pill.addEventListener('transitionend', () => pill.classList.remove('is-animated'), { once: true });
    }

    // Keep it aligned when fonts load or the window resizes
    new ResizeObserver(() => placeOn(current)).observe(links);
    document.fonts?.ready.then(() => placeOn(current));
  }

  setup();
</script>

<style>
  .site-nav {
    position: fixed;
    z-index: 10;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 32px);
  }

  /*
    Liquid glass pane: dark tint, strong blur and saturation, a bright rim
    and top highlight, and a soft shadow underneath.
  */
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 40px;
    height: 56px;
    padding: 0 6px 0 8px;
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      var(--glass-tint);
    border: 1px solid var(--glass-rim);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 rgb(255 255 255 / 0.05),
      inset 0 0 16px rgb(255 255 255 / 0.04),
      0 14px 36px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.35);
    /* heavy blur plus a slight darkening of whatever is behind keeps the labels readable */
    -webkit-backdrop-filter: blur(24px) saturate(160%) brightness(0.7);
    backdrop-filter: blur(24px) saturate(160%) brightness(0.7);
    font-family: var(--font-display);
    font-size: var(--text-nav);
    line-height: normal;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .logo,
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  /* 16px either side so the keyboard focus ring has room around the name */
  .logo {
    padding: 0 16px;
  }

  .logo-short {
    display: none;
  }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .links a {
    position: relative;
    z-index: 1;
    padding: 0 16px;
  }

  .external-label {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }

  .external-arrow {
    margin-left: 0.3em;
    font-size: 11px;
  }

  @media (hover: hover) and (pointer: fine) {
    .logo:hover,
    .links a:hover {
      color: var(--color-accent-2);
    }
  }

  .logo:focus-visible,
  .links a:focus-visible {
    color: var(--color-accent-2);
    outline-offset: -2px;
    box-shadow: none;
  }

  /* Active item: a flat light fill, no outline or shadow (positioned by the script) */
  .highlight {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--glass-active);
    transform-origin: left center;
    opacity: 0;
  }

  .links.js-ready .highlight {
    opacity: 1;
  }

  .highlight.is-animated {
    transition: transform var(--dur-base) var(--ease-in-out);
  }

  /* Without JavaScript, mark the active link directly */
  .links:not(.js-ready) a[aria-current='page'] {
    background: var(--glass-active);
  }

  /* Mobile: "z" as the logo, as in Figma */
  @media (max-width: 799.98px) {
    .site-nav {
      top: 16px;
    }
    .nav {
      gap: 8px;
      padding-left: 4px;
    }
    .links a {
      padding: 0 10px;
    }
    .logo-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .logo-short {
      display: inline;
    }
  }
</style>
