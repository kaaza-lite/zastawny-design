---
// Floating glass pill at the top of the screen.
// "Z" is Home; "Works" only opens the case study menu; About; LinkedIn.
//
// The active item sits on a light fill that slides from the previous page's item
// to the current one on page load (transform only).
//
// "Works" opens a menu of the case studies (click, tap, Enter or Space) on every screen size,
// with the current one highlighted.
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';
import finxThumb from '../assets/work/finx-thumb.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const caseStudies = ['/calastone', '/bamboo', '/juicyway'];
// Home highlights "Z", the case studies "Works", About "About"
const active = path === '/' ? 'home' : caseStudies.includes(path) ? 'works' : path === '/about' ? 'about' : null;

// The case study menu, in the Home order, with FinX last as "soon"
const thumb = async (src: ImageMetadata) => (await getImage({ src, width: 112, format: 'webp' })).src;
const menu = [
  ...(await Promise.all(
    ['calastone', 'bamboo', 'juicyway'].map(async (id) => {
      const e = (await getEntry('work', id))!;
      return { href: `/${id}`, title: e.data.title, meta: e.data.meta, thumb: await thumb(e.data.thumbnail), soon: false };
    }),
  )),
  { href: '', title: 'FinX', meta: 'Complex design system for fintech', thumb: await thumb(finxThumb), soon: true },
];
---

<header class="site-nav">
  <nav class="nav">
    <div class="links">
      <span class="highlight" aria-hidden="true"></span>
      <a href="/" data-key="home" class="home" aria-label="Home" aria-current={active === 'home' ? 'page' : undefined}><span class="z-mark">Z</span></a>
      <button type="button" data-key="works" class="works" aria-haspopup="true" aria-expanded="false" aria-controls="works-menu" data-current={active === 'works' ? '' : undefined}>Works<svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
      <a href="/about" data-key="about" aria-current={active === 'about' ? 'page' : undefined}>About</a>
      <a href="https://www.linkedin.com/in/zastawny/" target="_blank" rel="noopener" class="external">
        <span class="external-label">LinkedIn</span><svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg>
      </a>
    </div>
  </nav>

  <!-- Case study menu under "Works" -->
  <div class="works-menu" id="works-menu">
    {menu.map((m) =>
      m.soon ? (
        <div class="menu-item menu-item--soon" aria-disabled="true">
          <img src={m.thumb} alt="" width="56" height="36" loading="lazy" />
          <span class="menu-text"><span class="menu-title">{m.title}</span><span class="menu-meta">{m.meta}</span></span>
          <span class="menu-soon"><Tag tone="soon">Soon</Tag></span>
        </div>
      ) : (
        <a class="menu-item" href={m.href} aria-current={path === m.href ? 'page' : undefined}>
          <img src={m.thumb} alt="" width="56" height="36" loading="lazy" />
          <span class="menu-text"><span class="menu-title">{m.title}</span><span class="menu-meta">{m.meta}</span></span>
        </a>
      ),
    )}
  </div>
</header>

<script>
  // Slide the glass pill from the item that was active on the previous page.
  const STORAGE_KEY = 'nav-active';

  function setup() {
    const links = document.querySelector<HTMLElement>('.site-nav .links');
    const pill = links?.querySelector<HTMLElement>('.highlight');
    if (!links || !pill) return;

    const current = links.querySelector<HTMLElement>('[aria-current="page"], [data-current]');
    if (!current) {
      pill.hidden = true;
      return;
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Where the indicator sits for a link: right behind it, or a 44px circle centred on the Z
    const ROUND = 44;
    const box = (link: HTMLElement) => {
      const mark = link.querySelector<HTMLElement>('.z-mark');
      return mark
        ? { left: link.offsetLeft + mark.offsetLeft + (mark.offsetWidth - ROUND) / 2, width: ROUND }
        : { left: link.offsetLeft, width: link.offsetWidth };
    };
    const placeOn = (link: HTMLElement) => {
      const b = box(link);
      pill.style.left = `${b.left}px`;
      pill.style.width = `${b.width}px`;
      pill.classList.toggle('is-round', link.classList.contains('home'));
    };

    let previous: HTMLElement | null = null;
    try {
      const key = sessionStorage.getItem(STORAGE_KEY);
      if (key && key !== current.dataset.key) {
        previous = links.querySelector<HTMLElement>(`[data-key="${key}"]`);
      }
      sessionStorage.setItem(STORAGE_KEY, current.dataset.key ?? '');
    } catch {}

    placeOn(current);
    links.classList.add('js-ready');

    // Slide: start transformed onto the previous link, then animate to no transform
    if (previous && !reduceMotion) {
      const from = box(previous);
      const to = box(current);
      const dx = from.left - to.left;
      const sx = from.width / to.width;
      pill.style.transform = `translateX(${dx}px) scaleX(${sx})`;
      pill.getBoundingClientRect(); // commit the start position
      pill.classList.add('is-animated');
      pill.style.transform = '';
      pill.addEventListener('transitionend', () => pill.classList.remove('is-animated'), { once: true });
    }

    // Keep it aligned when fonts load or the window resizes
    new ResizeObserver(() => placeOn(current)).observe(links);
    document.fonts?.ready.then(() => placeOn(current));
  }

  // On the first load and after every page change
  document.addEventListener('astro:page-load', setup);

  // "Works" menu: opens while the mouse is over "Works" or the menu (desktop), a tap opens and closes it (touch)
  const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');

  function setupMenu() {
    const header = document.querySelector<HTMLElement>('.site-nav');
    const works = header?.querySelector<HTMLButtonElement>('.works');
    const menu = header?.querySelector<HTMLElement>('.works-menu');
    if (!header || !works || !menu) return;

    // Exactly as wide as the nav pill, right under it
    const place = () => {
      const nav = header.querySelector<HTMLElement>('.nav')!;
      menu.style.left = `${nav.offsetLeft}px`;
      menu.style.width = `${nav.offsetWidth}px`;
    };
    let closeTimer = 0;
    const open = () => {
      clearTimeout(closeTimer);
      if (menu.classList.contains('is-open')) return;
      place();
      menu.classList.add('is-open');
      works.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      clearTimeout(closeTimer);
      menu.classList.remove('is-open');
      works.setAttribute('aria-expanded', 'false');
    };
    // A short grace period, so the pointer can cross the gap between the nav and the menu
    const closeSoon = () => {
      clearTimeout(closeTimer);
      closeTimer = window.setTimeout(close, 200);
    };
    for (const el of [works, menu]) {
      el.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && hoverable.matches) open();
      });
      el.addEventListener('pointerleave', (e) => {
        if (e.pointerType === 'mouse' && hoverable.matches) closeSoon();
      });
    }
    // Touch: a tap opens and closes it. On desktop a click does nothing (hover opens it).
    works.addEventListener('click', (e) => {
      if (e.detail === 0) return; // keyboard, handled below
      if (hoverable.matches) return;
      if (menu.classList.contains('is-open')) close();
      else open();
    });
    // Keyboard: Tab moves along the nav as usual. On "Works", Enter or Space opens the menu,
    // the arrow keys move through it, Escape closes it, and Tab leaves it for the next nav item.
    const items = [...menu.querySelectorAll<HTMLElement>('a.menu-item')];
    for (const item of items) item.tabIndex = -1; // reached with the arrow keys, not Tab
    const after = works.nextElementSibling as HTMLElement | null;
    const isOpen = () => menu.classList.contains('is-open');
    const focusItem = (i: number) => items[(i + items.length) % items.length]?.focus();
    const openWithKeys = () => {
      open();
      const current = items.findIndex((item) => item.getAttribute('aria-current') === 'page');
      focusItem(Math.max(current, 0));
    };

    works.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
        e.preventDefault();
        if (isOpen() && e.key !== 'ArrowDown') close();
        else openWithKeys();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        open();
        focusItem(items.length - 1);
      }
    });
    menu.addEventListener('keydown', (e) => {
      const at = items.indexOf(document.activeElement as HTMLElement);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        focusItem(at + (e.key === 'ArrowDown' ? 1 : -1));
      } else if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        focusItem(e.key === 'Home' ? 0 : items.length - 1);
      } else if (e.key === 'Tab') {
        e.preventDefault();
        close();
        (e.shiftKey ? works : (after ?? works)).focus();
      }
    });
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        close();
        works.focus();
      }
    });
    header.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !(works.contains(next) || menu.contains(next))) close();
    });
    // A tap or click anywhere else closes it
    document.addEventListener('pointerdown', (e) => {
      const t = e.target as Node;
      if (!works.contains(t) && !menu.contains(t)) close();
    });
    window.addEventListener('resize', () => menu.classList.contains('is-open') && place());
  }

  document.addEventListener('astro:page-load', setupMenu);
</script>

<style>
  .site-nav {
    position: fixed;
    z-index: 10;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 32px);
  }

  /*
    Liquid glass pane: dark tint, strong blur and saturation, a bright rim
    and top highlight, and a soft shadow underneath.
  */
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    gap: 40px;
    height: 56px;
    padding: 0 8px;
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      var(--glass-tint);
    border: 1px solid var(--glass-rim);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 rgb(255 255 255 / 0.05),
      inset 0 0 16px rgb(255 255 255 / 0.04),
      0 14px 36px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.35);
    /* heavy blur plus a slight darkening of whatever is behind keeps the labels readable */
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--text-nav);
    line-height: normal;
    letter-spacing: normal;
    color: var(--color-text);
  }

  .links a,
  .links button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  /* 22px either side of each link and 8px inside the pill: 40px wider than the labels alone need */
  .links a,
  .links button {
    position: relative;
    z-index: 1;
    padding: 0 22px;
  }
  .links button {
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* Phones under 420px: tighter spacing, so the pill fits with Z, Works, About and LinkedIn */
  @media (max-width: 419.98px) {
    .nav {
      padding: 0 6px;
    }
    .links a,
    .links button {
      padding: 0 12px;
    }
  }
  /* Under 360px: a little tighter still */
  @media (max-width: 359.98px) {
    .links a,
    .links button {
      padding: 0 8px;
    }
  }
  /* Without the keyhole, Z sits as close to the left edge as its circle is to the top and bottom (5px) */
  .nav:has(> .links:first-child) {
    padding-left: 5px;
  }
  .links:first-child .home {
    padding-left: 2px;
  }

  .external-label {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }

  /* Home: a halfpixel Z on a 40px #121212 circle; the Z brightens on hover like the other items */
  .z-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #121212;
    font-family: var(--font-display); /* CS Pacify Halfpixel, which has one weight */
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
  }

  /* Icons from Lucide (lucide.dev, ISC licence): chevron-down on Works, arrow-up-right on LinkedIn */
  .nav-icon {
    flex: none;
    width: 14px;
    height: 14px;
    margin-left: 4px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .links a:hover,
    .links button:hover {
      color: var(--color-accent-2);
    }
  }

  .links a:focus-visible,
  .links button:focus-visible {
    color: var(--color-accent-2);
    outline-offset: -2px;
    box-shadow: none;
  }


  /* Active item: a flat light fill, no outline or shadow (positioned by the script) */
  .highlight {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--glass-active);
    transform-origin: left center;
    opacity: 0;
  }

  /* On Home: a 44px circle around the 40px Z */
  .highlight.is-round {
    top: calc(50% - 22px);
    bottom: auto;
    height: 44px;
    border-radius: 50%;
  }

  .links.js-ready .highlight {
    opacity: 1;
  }

  .highlight.is-animated {
    transition: transform var(--dur-base) var(--ease-in-out);
  }

  /* Without JavaScript, mark the active link directly */
  .links:not(.js-ready) [aria-current='page'],
  .links:not(.js-ready) [data-current] {
    background: var(--glass-active);
  }

  /* ---------- "Works" menu: the same glass as the pill ---------- */
  .works-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 330px;
    padding: 6px;
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      var(--glass-tint);
    border: 1px solid var(--glass-rim);
    border-radius: 20px;
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      0 14px 36px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
  }
  .works-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  /* 8px all round, so the thumbnail sits as far from the edge as from the top */
  .menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border-radius: 14px;
    color: var(--color-text);
    text-decoration: none;
  }
  .menu-item img {
    flex: none;
    width: 56px;
    height: 36px;
    object-fit: cover;
    border-radius: 6px;
  }
  .menu-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .menu-title {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.2;
  }
  .menu-meta {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.3;
    color: inherit;
  }

  /* The case study you're on: the same fill as the active nav item */
  .menu-item[aria-current='page'] {
    background: var(--glass-active);
  }

  @media (hover: hover) and (pointer: fine) {
    a.menu-item:not([aria-current='page']):hover {
      background: rgb(255 255 255 / 0.05);
      color: var(--color-accent-2);
    }
  }
  a.menu-item:focus-visible {
    outline-offset: -2px;
    box-shadow: none;
  }

  .menu-item--soon {
    opacity: 0.45;
    cursor: default;
  }
  .menu-soon {
    display: flex;
    flex: none;
    margin: 0 8px 0 auto;
  }
  /* The tile pill scaled to 12px text (three quarters of the 16px one) */
  .menu-soon :global(.tag) {
    padding: 3px 9px;
    font-size: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .works-menu,
    .works-menu.is-open {
      transform: none;
      transition: none;
    }
  }

</style>
