---
// Floating pill navigation. Same items and labels as the Figma nav.
//
// REVIEW ONLY: three layout variants (a, b, c) share this markup and differ in CSS.
// Switch with ?nav=a|b|c in the URL. Once one is picked, delete the other two
// variant blocks and the switcher script.
//
// The active item gets a highlight that slides from the previous page's item
// to the current one on page load. It's drawn with clip-path, so only
// clip-path animates.

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const caseStudies = ['/calastone', '/bamboo', '/juicyway'];
const active = path === '/' || caseStudies.includes(path) ? 'works' : path === '/about' ? 'about' : null;
---

<header class="site-nav" data-variant="a">
  <script is:inline>
    // Review switcher: apply ?nav=a|b|c before first paint and remember it for this visit.
    (function () {
      var el = document.currentScript.parentElement;
      var v = null;
      try {
        v = new URLSearchParams(location.search).get('nav');
        if (v) sessionStorage.setItem('nav-variant', v);
        else v = sessionStorage.getItem('nav-variant');
      } catch (e) {}
      if (v === 'a' || v === 'b' || v === 'c') el.setAttribute('data-variant', v);
    })();
  </script>
  <nav class="nav">
    <a class="logo" href="/">
      <span class="logo-full">zastawny</span>
      <span class="logo-short" aria-hidden="true">z</span>
    </a>
    <div class="links">
      <span class="highlight" aria-hidden="true"></span>
      <a href="/" data-key="works" aria-current={active === 'works' ? 'page' : undefined}>works</a>
      <a href="/about" data-key="about" aria-current={active === 'about' ? 'page' : undefined}>about</a>
      <a href="https://www.linkedin.com/in/zastawny/" target="_blank" rel="noopener" class="external">
        <span class="external-label">linkedin</span><span class="external-arrow" aria-hidden="true">⇗</span>
      </a>
    </div>
  </nav>
</header>

<script>
  // Slide the highlight from the item that was active on the previous page.
  const STORAGE_KEY = 'nav-active';

  function setup() {
    const links = document.querySelector<HTMLElement>('.site-nav .links');
    const highlight = links?.querySelector<HTMLElement>('.highlight');
    if (!links || !highlight) return;

    const current = links.querySelector<HTMLElement>('a[aria-current="page"]');
    if (!current) {
      highlight.hidden = true;
      return;
    }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Clip the full-width highlight down to one link
    const clipTo = (link: HTMLElement) => {
      const left = link.offsetLeft - highlight.offsetLeft;
      const right = highlight.offsetLeft + highlight.offsetWidth - (link.offsetLeft + link.offsetWidth);
      highlight.style.clipPath = `inset(0 ${right}px 0 ${left}px round 999px)`;
    };

    let previous: HTMLElement | null = null;
    try {
      const key = sessionStorage.getItem(STORAGE_KEY);
      if (key && key !== current.dataset.key) {
        previous = links.querySelector<HTMLElement>(`a[data-key="${key}"]`);
      }
      sessionStorage.setItem(STORAGE_KEY, current.dataset.key ?? '');
    } catch {}

    // Start where the previous page left off, then slide to the current item
    highlight.classList.remove('is-animated');
    clipTo(previous && !reduceMotion ? previous : current);
    links.classList.add('js-ready');
    if (previous && !reduceMotion) {
      highlight.getBoundingClientRect(); // commit the start position
      highlight.classList.add('is-animated');
      clipTo(current);
    }

    // Keep it aligned when fonts load or the window resizes
    new ResizeObserver(() => {
      highlight.classList.remove('is-animated');
      clipTo(current);
    }).observe(links);
    document.fonts?.ready.then(() => clipTo(current));
  }

  setup();
</script>

<style>
  /* ---------- Shared ---------- */
  .site-nav {
    position: fixed;
    z-index: 10;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: min(1216px, calc(100% - 64px));
    pointer-events: none; /* only the visible pill catches clicks */
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    font-family: var(--font-display);
    font-size: var(--text-nav);
    line-height: normal;
    letter-spacing: 0;
    color: var(--color-text);
  }

  /* The pill surface: translucent, blurred, hairline border, soft shadow */
  .nav,
  .logo,
  .links {
    pointer-events: auto;
  }

  .logo,
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .logo-short {
    display: none;
  }

  .links {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .links a {
    position: relative;
    z-index: 1;
    padding: 0 12px;
  }

  .external-label {
    text-decoration: underline;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }

  .external-arrow {
    margin-left: 0.3em;
    font-size: 11px;
  }

  @media (hover: hover) and (pointer: fine) {
    .logo:hover,
    .links a:hover {
      color: var(--color-accent-2);
    }
  }

  .logo:focus-visible,
  .links a:focus-visible {
    color: var(--color-accent-2);
    outline-offset: -2px;
  }

  /* Active highlight, clipped to the current link by the script */
  .highlight {
    position: absolute;
    inset: 4px 0;
    border-radius: var(--radius-pill);
    background: var(--color-border-nav);
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }

  .links.js-ready .highlight {
    opacity: 1;
  }

  .highlight.is-animated {
    transition: clip-path var(--dur-base) var(--ease-in-out);
  }

  /* Without JavaScript, mark the active link directly */
  .links:not(.js-ready) a[aria-current='page'] {
    background: var(--color-border-nav);
  }

  @media (max-width: 799.98px) {
    .site-nav {
      top: 16px;
      width: calc(100% - 32px);
    }
    .logo-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .logo-short {
      display: inline;
    }
  }

  /* ---------- Variant A: full-width pill bar (closest to Figma) ---------- */
  .site-nav[data-variant='a'] .nav {
    padding: 0 39px 0 51px;
    background: var(--color-nav-bg);
    border: 1px solid var(--color-border-nav);
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .site-nav[data-variant='a'] .links {
    gap: 28px;
  }

  @media (max-width: 1279.98px) {
    .site-nav[data-variant='a'] {
      width: min(736px, calc(100% - 64px));
    }
    .site-nav[data-variant='a'] .nav {
      padding: 0 19px 0 31px;
    }
    .site-nav[data-variant='a'] .links {
      gap: 8px;
    }
  }

  @media (max-width: 799.98px) {
    .site-nav[data-variant='a'] {
      width: min(736px, calc(100% - 32px));
    }
    .site-nav[data-variant='a'] .nav {
      padding: 0 6px 0 15px;
    }
    .site-nav[data-variant='a'] .links {
      gap: 0;
    }
    .site-nav[data-variant='a'] .links a {
      padding: 0 8px;
    }
  }

  /* ---------- Variant B: compact centred pill ---------- */
  .site-nav[data-variant='b'] {
    width: max-content;
    max-width: calc(100% - 32px);
  }
  .site-nav[data-variant='b'] .nav {
    gap: 12px;
    padding: 0 4px 0 22px;
    background: var(--color-nav-bg);
    border: 1px solid var(--color-border-nav);
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .site-nav[data-variant='b'] .links a {
    padding: 0 14px;
  }

  @media (max-width: 799.98px) {
    .site-nav[data-variant='b'] .nav {
      gap: 4px;
      padding-left: 18px;
    }
    .site-nav[data-variant='b'] .links a {
      padding: 0 10px;
    }
  }

  /* ---------- Variant C: split pills, outlined active state ---------- */
  .site-nav[data-variant='c'] .logo,
  .site-nav[data-variant='c'] .links {
    height: 52px;
    background: var(--color-nav-bg);
    border: 1px solid var(--color-border-nav);
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .site-nav[data-variant='c'] .logo {
    padding: 0 24px;
  }
  .site-nav[data-variant='c'] .links {
    padding: 0 4px;
  }
  .site-nav[data-variant='c'] .links a {
    padding: 0 16px;
  }
  /* Brighter active fill than A and B */
  .site-nav[data-variant='c'] .highlight,
  .site-nav[data-variant='c'] .links:not(.js-ready) a[aria-current='page'] {
    background: var(--color-divider);
  }

  @media (max-width: 799.98px) {
    .site-nav[data-variant='c'] .logo {
      justify-content: center;
      width: 52px;
      padding: 0;
    }
    .site-nav[data-variant='c'] .links a {
      padding: 0 10px;
    }
  }
</style>
