---
// Datamosh between pages (see src/scripts/datamosh.ts for what datamoshing is).
//
// Pages change without reloading (src/scripts/navigation.ts), and this canvas stays on
// screen the whole time, so it covers the swap:
//   leaving   the visible page is redrawn into the canvas (src/scripts/snapshot.ts) and
//             its blocks get dragged toward the link you clicked, while the next page loads
//   arriving  the new page is swapped in underneath; the old pixels keep moving with new
//             motion while blocks tear open, one by one, and show the new page
// Opening a page directly, the page's own picture briefly melts and resolves instead.
// Anything marked data-scramble (the page title) scrambles and resolves as it arrives.
// Skipped entirely with reduced motion.
---

<canvas class="page-mosh" aria-hidden="true"></canvas>

<script>
  import { Mosh, waves, MOSH_FPS } from '../scripts/datamosh';
  import { snapshot } from '../scripts/snapshot';
  import { scrambled, TITLE_CHARS } from '../scripts/glitch';

  const EXIT = 300;  // ms, leaving: the page is dragged toward the link
  const ENTER = 420; // ms, arriving: the old frame melts away into the new page
  const BLOCK = 16;  // block size in CSS pixels
  const LATE = 800;  // ms after a direct load; later than this the page has settled

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const scale = Math.min(window.devicePixelRatio || 1, 2);
  const canvas = document.querySelector<HTMLCanvasElement>('.page-mosh')!;
  let mosh: Mosh | null = null;

  const fit = () => {
    canvas.width = Math.max(1, Math.round(window.innerWidth * scale)); // at least 1, even in a hidden tab
    canvas.height = Math.max(1, Math.round(window.innerHeight * scale));
    mosh = new Mosh(canvas, BLOCK * scale);
    return mosh;
  };

  // Run `frame` at the mosh frame rate for `duration` ms; resolves when done
  function run(duration: number, frame: (t: number) => void) {
    return new Promise<void>((resolve) => {
      const start = performance.now();
      let last = -Infinity;
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        if (now - last >= 1000 / MOSH_FPS || t >= 1) {
          frame(t);
          last = now;
        }
        if (t >= 1) return resolve();
        requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }

  const finish = () => {
    canvas.getContext('2d')?.clearRect(0, 0, canvas.width, canvas.height);
    canvas.classList.remove('is-on');
  };

  // ---------- Arriving: tear the old frame open onto the page underneath ----------
  async function arrive(strength: number) {
    const m = mosh;
    if (!m) return finish();

    // Title scramble layers; the real text stays for screen readers
    const scrambles = [...document.querySelectorAll<HTMLElement>('[data-scramble]')].map((el) => {
      const layer = document.createElement('span');
      layer.className = 'page-scramble';
      layer.setAttribute('aria-hidden', 'true');
      el.classList.add('is-scrambling');
      el.append(layer);
      return { el, layer, text: el.textContent?.trim() ?? '' };
    });

    // Each block opens at its own moment, roughly top to bottom
    const h = canvas.height;
    const opensAt = new Map<number, number>();
    const openTime = (x: number, y: number) => {
      const key = y * 100000 + x;
      if (!opensAt.has(key)) opensAt.set(key, 0.05 + Math.random() * 0.55 + (y / h) * 0.3);
      return opensAt.get(key)!;
    };
    const wave = waves();
    await run(ENTER * (0.75 + 0.25 * strength), (t) => {
      const speed = 16 * scale * (1 - t) ** 0.6 * strength;
      m.step(
        (x, y) => {
          const [dx, dy, s] = wave(x, y);
          return [dx * s * speed * 0.7, (0.6 + dy * 0.4) * s * speed];
        },
        (x, y) => (t >= openTime(x, y) ? 'clear' : Math.random() < 0.8 ? 'move' : 'keep'),
      );
      for (const s of scrambles) s.layer.textContent = scrambled(s.text, t, true, TITLE_CHARS);
    });
    finish();
    for (const s of scrambles) {
      s.layer.remove();
      s.el.classList.remove('is-scrambling');
    }
  }

  // ---------- Leaving: drag the page toward the link ----------
  function leave(toX: number, toY: number) {
    const m = fit();
    m.draw(snapshot(scale));
    canvas.classList.add('is-on');
    const wave = waves();
    const px = toX * scale;
    const py = toY * scale;
    return run(EXIT, (t) => {
      const speed = 14 * scale * Math.min(1, t * 1.6);
      m.step(
        (x, y) => {
          // Pulled toward the link that was clicked, with a swirl on top
          const dx = px - x;
          const dy = py - y;
          const d = Math.hypot(dx, dy) || 1;
          const [wx, wy, s] = wave(x, y);
          return [(dx / d) * speed + wx * s * speed * 0.6, (dy / d) * speed + wy * s * speed * 0.6];
        },
        () => (Math.random() < 0.6 ? 'move' : 'keep'),
      );
    });
  }

  if (reduce) {
    finish();
  } else {
    // A direct load (typing the address, refreshing): the page itself melts in briefly
    if (performance.now() < LATE && window.innerWidth > 0) {
      try {
        fit().draw(snapshot(scale));
        canvas.classList.add('is-on');
        arrive(0.6);
      } catch {
        finish();
      }
    }

    // Where the last click was, so the page is pulled toward the link that was clicked
    let click = { x: window.innerWidth / 2, y: window.innerHeight / 2, at: 0 };
    document.addEventListener('click', (e) => {
      click = { x: e.clientX, y: e.clientY, at: e.detail ? performance.now() : 0 };
    }, true);

    // Leaving: run the melt while the next page loads, and swap only when both are done
    let leaving: Promise<void> | null = null;
    document.addEventListener('astro:before-preparation', (e) => {
      let x = window.innerWidth / 2;
      let y = window.innerHeight / 2;
      if (performance.now() - click.at < 1000) {
        x = click.x;
        y = click.y;
      } else if (e.sourceElement) {
        // keyboard: the link's centre
        const box = e.sourceElement.getBoundingClientRect();
        x = box.left + box.width / 2;
        y = box.top + box.height / 2;
      }
      // If anything goes wrong with the effect, just change the page without it
      try {
        leaving = window.innerWidth > 0 ? leave(x, y) : null;
      } catch {
        leaving = null;
        finish();
      }
      if (!leaving) return;
      const load = e.loader;
      e.loader = async () => {
        await Promise.all([load(), leaving]);
      };
    });

    // Arriving: the new page is now under the canvas
    document.addEventListener('astro:after-swap', () => {
      if (!leaving) return;
      leaving = null;
      arrive(1).catch(finish);
    });
  }
</script>

<style>
  /* Full-screen, under the nav (z-index 10) so the nav stays put between pages */
  .page-mosh {
    position: fixed;
    inset: 0;
    z-index: 9;
    width: 100%;
    height: 100%;
    pointer-events: none;
    visibility: hidden;
  }
  .page-mosh.is-on {
    visibility: visible;
  }

  /* Title scramble: the real text goes transparent, the scramble sits on top */
  :global([data-scramble]) {
    position: relative;
  }
  :global([data-scramble].is-scrambling) {
    color: transparent;
  }
  /* Sized to its own text and centred on the title, so wider fallback symbols don't
     force an extra line; it only wraps where the title itself would (small phones). */
  :global(.page-scramble) {
    position: absolute;
    top: 0;
    left: 50%;
    width: max-content;
    max-width: calc(100vw - 40px);
    transform: translateX(-50%);
    color: var(--color-text);
    text-align: center;
  }
</style>
