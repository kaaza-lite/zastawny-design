---
// Case study card on Home: thumbnail, title, one-line description.
// With `href` the whole card is a link. Without it, the card is static.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';
import type { PaletteName } from '../data/palettes';

interface Props {
  title: string;
  meta: string;
  image: ImageMetadata;
  imageLight?: ImageMetadata; // a separate picture for light mode
  alt: string;
  href?: string;
  palette?: PaletteName;
  soon?: boolean;
  tint?: boolean;   // the dark overlay Figma puts on the Bamboo image
  eager?: boolean;  // load immediately (cards in the first row)
  heading?: 'h2' | 'h3'; // title level: h2 on Home, h3 under "other projects"
  fit?: 'cover' | 'contain'; // cover fills the frame (cropped), contain shows the whole image
  dim?: boolean;    // fade the image to 25%, the "soon" look (on by default for soon cards)
  sizes?: string;   // image sizes attribute, when the card isn't in the usual two-column grid
}

const { title, meta, image, imageLight, alt, href, palette = 'neutral', soon = false, tint = false, eager = false, heading = 'h2', fit = 'cover', dim = soon, sizes: sizesProp } = Astro.props;
const Tagname = href ? 'a' : 'div';
const Heading = heading;

const img = await getImage({ src: image, widths: [320, 480, 640, 800, 1120, 1600, 1820], format: 'webp' });
const imgLight = imageLight && (await getImage({ src: imageLight, widths: [320, 480, 640, 800, 1120, 1600, 1820], format: 'webp' }));
const sizes = sizesProp ?? '(max-width: 799.98px) calc(100vw - 80px), (max-width: 1279.98px) calc(50vw - 82px), 558px';
---

<Tagname
  class:list={['card', { 'card--link': href, 'card--soon': soon }]}
  href={href}
  data-glitch-card={href ? palette : undefined}
>
  <div class:list={['thumb', { 'thumb--tint': tint, 'thumb--dim': dim }]}>
    <img
      class:list={['thumb-img', { 'thumb-img--contain': fit === 'contain', 'thumb-img--dark': imageLight }]}
      src={img.src}
      srcset={img.srcSet.attribute}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      decoding="async"
      loading={eager ? 'eager' : 'lazy'}
    />
    {imgLight && imageLight && (
      <img
        class:list={['thumb-img', 'thumb-img--light', { 'thumb-img--contain': fit === 'contain' }]}
        src={imgLight.src}
        srcset={imgLight.srcSet.attribute}
        sizes={sizes}
        width={imageLight.width}
        height={imageLight.height}
        alt={alt}
        decoding="async"
        loading={eager ? 'eager' : 'lazy'}
      />
    )}
  </div>
  <div class="text">
    <div class="title-row">
      <Heading class="title">{title}</Heading>
      {soon && <Tag tone="soon">Soon</Tag>}
    </div>
    <p class="meta">{meta}</p>
  </div>
</Tagname>

<style>
  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    position: relative;
    height: 266px;
    overflow: hidden;
  }

  .thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dark overlay on the Bamboo image */
  .thumb--tint::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--thumb-tint);
    pointer-events: none;
  }

  .thumb-img--contain {
    object-fit: contain;
  }

  .thumb--dim {
    opacity: 0.25;
  }

  /* A card with its own light mode picture shows one or the other */
  .thumb-img--light {
    display: none;
  }
  :global([data-mode='light']) .thumb-img--dark {
    display: none;
  }
  :global([data-mode='light']) .thumb-img--light {
    display: block;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--color-text);
  }

  .meta {
    font-size: var(--text-card-meta);
    line-height: var(--leading-card-meta);
    letter-spacing: normal;
    color: var(--color-text);
  }
</style>
