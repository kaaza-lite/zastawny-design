---
// Case study card on Home: thumbnail, title, one-line description.
// With `href` the whole card is a link and gets the hover effect.
// Without it (FinX), the card is static and the image is dimmed.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';

interface Props {
  title: string;
  meta: string;
  image: ImageMetadata;
  alt: string;
  href?: string;
  soon?: boolean;
  tint?: boolean;   // the dark overlay Figma puts on the Bamboo image
  eager?: boolean;  // load immediately (cards in the first row)
}

const { title, meta, image, alt, href, soon = false, tint = false, eager = false } = Astro.props;
const Tagname = href ? 'a' : 'div';
---

<Tagname class:list={['card', { 'card--link': href, 'card--soon': soon }]} href={href}>
  <div class:list={['thumb', { 'thumb--tint': tint }]}>
    <Image
      src={image}
      alt={alt}
      widths={[320, 480, 640, 800, 1120]}
      sizes="(max-width: 799.98px) calc(100vw - 80px), (max-width: 1279.98px) calc(50vw - 82px), 558px"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="text">
    <div class="title-row">
      <h2 class="title">{title}</h2>
      {soon && <Tag tone="soon">soon</Tag>}
    </div>
    <p class="meta">{meta}</p>
  </div>
</Tagname>

<style>
  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    position: relative;
    height: 266px;
    overflow: hidden; /* keeps the hover zoom inside the frame */
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Dark overlay on the Bamboo image */
  .thumb--tint::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.2);
    pointer-events: none;
  }

  .card--soon .thumb {
    opacity: 0.25;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .meta {
    font-size: var(--text-card-meta);
    line-height: var(--leading-card-meta);
    letter-spacing: var(--tracking-card-meta);
    color: var(--color-text-muted);
  }

  /*
    Hover highlight: the image zooms slightly inside its frame and the
    title nudges right. Mouse and trackpad only; keyboard focus gets the same.
  */
  .thumb :global(img),
  .title {
    transition: transform var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card--link:hover .thumb :global(img) {
      transform: scale(1.03);
    }
    .card--link:hover .title {
      transform: translateX(4px);
    }
  }

  .card--link:focus-visible .thumb :global(img) {
    transform: scale(1.03);
  }
  .card--link:focus-visible .title {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img),
    .title {
      transition: none;
      transform: none !important;
    }
  }
</style>
