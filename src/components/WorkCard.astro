---
// Case study card on Home: thumbnail, title, one-line description.
// With `href` the whole card is a link and gets the datamosh hover (src/scripts/datamosh.ts);
// the title glitch is coloured with that case study's monochrome ramp (src/data/palettes.ts).
// Without it (FinX), the card is static.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from './Tag.astro';
import { palettes, type PaletteName } from '../data/palettes';

interface Props {
  title: string;
  meta: string;
  image: ImageMetadata;
  alt: string;
  href?: string;
  palette?: PaletteName;
  soon?: boolean;
  tint?: boolean;   // the dark overlay Figma puts on the Bamboo image
  eager?: boolean;  // load immediately (cards in the first row)
  heading?: 'h2' | 'h3'; // title level: h2 on Home, h3 under "other projects"
  fit?: 'cover' | 'contain'; // cover fills the frame (cropped), contain shows the whole image
  dim?: boolean;    // fade the image to 25%, the "soon" look (on by default for soon cards)
}

const { title, meta, image, alt, href, palette = 'neutral', soon = false, tint = false, eager = false, heading = 'h2', fit = 'cover', dim = soon } = Astro.props;
const Tagname = href ? 'a' : 'div';
const Heading = heading;
const ramp = palettes[palette];

const img = await getImage({ src: image, widths: [320, 480, 640, 800, 1120], format: 'webp' });
const sizes = '(max-width: 799.98px) calc(100vw - 80px), (max-width: 1279.98px) calc(50vw - 82px), 558px';

// Ramp colours as CSS variables, for the title glitch
const rampVars = ramp.map((c, i) => `--g${i}:${c}`).join(';');
---

<Tagname
  class:list={['card', { 'card--link': href, 'card--soon': soon }]}
  href={href}
  data-glitch-card={href ? palette : undefined}
  style={href ? rampVars : undefined}
>
  <div class:list={['thumb', { 'thumb--tint': tint, 'thumb--dim': dim }]}>
    <img
      class:list={['thumb-img', { 'thumb-img--contain': fit === 'contain' }]}
      src={img.src}
      srcset={img.srcSet.attribute}
      sizes={sizes}
      width={image.width}
      height={image.height}
      alt={alt}
      decoding="async"
      loading={eager ? 'eager' : 'lazy'}
    />
    {href && <canvas class="glitch" aria-hidden="true"></canvas>}
  </div>
  <div class="text">
    <div class="title-row">
      <Heading class="title">
        <span class="title-text scramble-source">{title}</span>
        {href && (
          <>
            <span class="scramble scramble--title" aria-hidden="true"></span>
            <span class="ghost ghost--a" aria-hidden="true">{title}</span>
            <span class="ghost ghost--b" aria-hidden="true">{title}</span>
          </>
        )}
      </Heading>
      {soon && <Tag tone="soon">Soon</Tag>}
    </div>
    <p class="meta">
      <span class="scramble-source">{meta}</span>
      {href && (
        <>
          <span class="scramble scramble--meta" aria-hidden="true"></span>
          <span class="ghost ghost--a" aria-hidden="true">{meta}</span>
          <span class="ghost ghost--b" aria-hidden="true">{meta}</span>
        </>
      )}
    </p>
  </div>
</Tagname>

<script>
  import { Mosh, waves, cover, gradientMap, MOSH_FPS } from '../scripts/datamosh';
  import { palettes, type PaletteName } from '../data/palettes';
  import { scrambled, SCRAMBLE_CHARS, TITLE_CHARS } from '../scripts/glitch';

  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const BLOCK = 12;     // block size in CSS pixels
  const BURST = 650;    // ms: the melt when the pointer arrives, and the title glitch with it
  const REACH = 0.4;    // how far around the pointer the image gets dragged (share of the card width)

  // Set up the cards on the first load and after every page change
  document.addEventListener('astro:page-load', () => {
    for (const card of document.querySelectorAll<HTMLElement>('[data-glitch-card]')) {
      const thumb = card.querySelector<HTMLElement>('.thumb')!;
      const shown = card.querySelector<HTMLImageElement>('.thumb-img')!;
      const cnv = card.querySelector<HTMLCanvasElement>('.glitch')!;
      // Scramble layers for the title and the category line, each with its real text
      const scrambles = [...card.querySelectorAll<HTMLElement>('.scramble')].map((el) => ({
        el,
        text: el.parentElement?.querySelector('.scramble-source')?.textContent ?? '',
        // the title is in CS Ariston Halfpixel, which only has letters
        chars: el.classList.contains('scramble--title') ? TITLE_CHARS : SCRAMBLE_CHARS,
      }));

      // With srcset, naturalWidth is scaled by pixel density, so use a plain
      // copy of the chosen file (already cached) to get its real pixels.
      const source = new Image();
      const sync = () => {
        if (shown.currentSrc && source.src !== shown.currentSrc) source.src = shown.currentSrc;
      };
      if (shown.complete) sync();
      else shown.addEventListener('load', sync, { once: true });

      let mosh: Mosh | null = null;
      let clean: HTMLCanvasElement | null = null;
      let tinted: HTMLCanvasElement | null = null; // the picture in this case study's colours
      const ramp = palettes[card.dataset.glitchCard as PaletteName] ?? palettes.neutral;
      let raf = 0;
      let dpr = 1;
      let hovering = false;
      let leftAt = 0;
      let burstAt = 0;
      let lastFrame = 0;
      let still = 0; // frames with no movement
      // Pointer position and how far it moved since the last frame, in canvas pixels
      const pointer = { x: 0, y: 0, vx: 0, vy: 0, inside: false };
      let wave = waves();

      const ready = () => {
        sync();
        if (!source.complete || !source.naturalWidth) return false;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        const w = Math.round(thumb.clientWidth * dpr);
        const h = Math.round(thumb.clientHeight * dpr);
        if (!clean || clean.width !== w || clean.height !== h) {
          cnv.width = w;
          cnv.height = h;
          clean = cover(source, w, h);
          tinted = gradientMap(clean, ramp);
          mosh = new Mosh(cnv, BLOCK * dpr);
        }
        return true;
      };

      const frame = (now: number) => {
        raf = requestAnimationFrame(frame);
        if (now - lastFrame < 1000 / MOSH_FPS || !mosh || !clean || !tinted) return;
        lastFrame = now;

        const burst = Math.max(0, 1 - (now - burstAt) / BURST);
        const leaving = !hovering;
        const moving = Math.min(1, Math.hypot(pointer.vx, pointer.vy) / (6 * dpr));
        const reach = cnv.width * REACH;
        const swirl = 16 * dpr * burst;

        mosh.step(
          (x, y) => {
            // Blocks near the pointer get dragged the way it's moving
            const near = pointer.inside ? Math.max(0, 1 - Math.hypot(x - pointer.x, y - pointer.y) / reach) ** 1.5 : 0;
            const [dx, dy, s] = wave(x, y);
            return [pointer.vx * near * 1.4 + dx * s * swirl, pointer.vy * near * 1.4 + dy * s * swirl];
          },
          () => {
            const r = Math.random();
            // Arriving: the colour floods in. Leaving: the photo comes back fast.
            // Still pointer: catches up slowly. Moving: barely.
            const catchUp = leaving ? 0.35 : Math.max(0.3 * burst, 0.015 + 0.09 * (1 - moving) * (1 - burst));
            if (r < catchUp) return 'clean';
            return r < 0.88 ? 'move' : 'keep';
          },
          leaving ? clean : tinted,
        );

        for (const s of scrambles) s.el.textContent = burst > 0 ? scrambled(s.text, 1 - burst, true, s.chars) : '';
        if (burst <= 0) card.classList.remove('is-glitching', 'is-scrambling');

        // Movement fades between frames, so the smear stops when the pointer does
        pointer.vx *= 0.5;
        pointer.vy *= 0.5;

        // Resting pointer and a clean picture: pause until it moves again
        if (!leaving && burst <= 0 && moving < 0.05) still++;
        else still = 0;
        if (!leaving && still > 36) {
          mosh.draw(tinted);
          cancelAnimationFrame(raf);
          raf = 0;
          return;
        }

        // After leaving, stop once the picture has had time to come back clean
        if (leaving && now - leftAt > 450) {
          cancelAnimationFrame(raf);
          raf = 0;
          cnv.classList.remove('is-on');
          card.classList.remove('is-glitching', 'is-scrambling');
        }
      };

      const enter = () => {
        if (reduce.matches || !ready() || !mosh || !clean) return;
        hovering = true;
        burstAt = performance.now();
        wave = waves();
        if (!raf) {
          mosh.draw(clean);
          cnv.classList.add('is-on');
          raf = requestAnimationFrame(frame);
        }
        card.classList.add('is-glitching', 'is-scrambling');
      };
      const leave = () => {
        hovering = false;
        pointer.inside = false;
        leftAt = performance.now();
        if (!raf) cnv.classList.remove('is-on');
      };

      card.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'mouse' && fine.matches) enter();
      });
      card.addEventListener('pointermove', (e) => {
        const box = thumb.getBoundingClientRect();
        const x = (e.clientX - box.left) * dpr;
        const y = (e.clientY - box.top) * dpr;
        if (pointer.inside) {
          pointer.vx += x - pointer.x;
          pointer.vy += y - pointer.y;
        }
        pointer.x = x;
        pointer.y = y;
        pointer.inside = true;
        if (hovering && !raf) {
          still = 0;
          raf = requestAnimationFrame(frame);
        }
      });
      card.addEventListener('pointerleave', leave);
      card.addEventListener('focus', () => {
        if (card.matches(':focus-visible')) enter();
      });
      card.addEventListener('blur', leave);
    }
  });
</script>

<style>
  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px;
    background: var(--color-surface);
    border-radius: var(--radius-card);
    color: inherit;
    text-decoration: none;
  }

  .thumb {
    position: relative;
    height: 266px;
    overflow: hidden;
  }

  .thumb-img,
  .glitch {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Glitch canvas sits over the image, hidden except while a glitch plays */
  .glitch {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .glitch.is-on {
    opacity: 1;
  }

  /* Dark overlay on the Bamboo image */
  .thumb--tint::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.2);
    pointer-events: none;
  }

  .thumb-img--contain {
    object-fit: contain;
  }

  .thumb--dim {
    opacity: 0.25;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .title-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .title {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--text-card-title);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .meta {
    position: relative;
    font-size: var(--text-card-meta);
    line-height: var(--leading-card-meta);
    letter-spacing: var(--tracking-card-meta);
    color: var(--color-text);
  }

  /*
    Text glitch on the title and the category line: two ghost copies in the
    ramp colours jump around while the image glitches.
  */
  .ghost {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }
  .ghost--a {
    color: var(--g4);
    clip-path: inset(0 0 52% 0);
  }
  .ghost--b {
    color: var(--g3);
    clip-path: inset(48% 0 0 0);
  }
  .card.is-glitching .ghost--a {
    animation: ghost-a 280ms steps(1, end) infinite;
  }
  .card.is-glitching .ghost--b {
    animation: ghost-b 280ms steps(1, end) infinite;
  }
  /* The category line is small, so its ghosts move less */
  .meta .ghost {
    --shift: 0.5;
  }

  @keyframes ghost-a {
    0% { opacity: 1; transform: translateX(calc(-6px * var(--shift, 1))); }
    25% { transform: translateX(calc(4px * var(--shift, 1))); }
    50% { opacity: 0; }
    75% { opacity: 1; transform: translateX(calc(-2px * var(--shift, 1))); }
  }
  @keyframes ghost-b {
    0% { opacity: 1; transform: translateX(calc(5px * var(--shift, 1))); }
    25% { opacity: 0; }
    50% { opacity: 1; transform: translateX(calc(-4px * var(--shift, 1))); }
    75% { transform: translateX(calc(2px * var(--shift, 1))); }
  }

  /* Scramble on the title and the category line: random characters that resolve
     back to the real text. The real text stays in place (transparent) for screen readers. */
  .scramble {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }
  .scramble--title {
    color: var(--g5);
  }
  .scramble--meta {
    color: var(--g5);
  }
  .card.is-scrambling .scramble {
    opacity: 1;
  }
  .card.is-scrambling .scramble-source {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch,
    .ghost,
    .scramble {
      display: none;
    }
    .scramble-source {
      opacity: 1 !important;
    }
  }
</style>
