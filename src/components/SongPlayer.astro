---
// A small music player in the bottom right corner: a round play/pause button in the
// nav's glass style (with a play / pause tooltip above it), and a little equalizer
// next to it while the song plays.
//
// The music comes from Spotify's official embed, kept invisible. It only loads when
// someone reaches for the button, so pages stay fast and Spotify isn't contacted for
// visitors who never press play.
//
// Change the songs and the loops here. Times are minutes:seconds; a song plays from
// loopFrom to loopTo, then jumps back to loopFrom (no loopTo: the whole song, then again).
// The Redesigns page has its own song: arriving there switches to it (and carries on playing
// if music was on), leaving switches back to the main one.
// Note: visitors who aren't logged in to Spotify in their browser only get Spotify's
// own 30-second preview, so for them the preview loops instead.
const songs = {
  main: { spotify: 'https://open.spotify.com/track/2t9JBAhPDfgnvUlcL045qC', loopFrom: '0:00', loopTo: '2:00' },
  redesigns: { spotify: 'https://open.spotify.com/track/4EqJGKB8ptzxBbbwFimdI3', loopFrom: '0:00', loopTo: '' },
};

const seconds = (t: string) => (t ? t.split(':').reduce((sum, part) => sum * 60 + Number(part), 0) : 0);
const uriOf = (url: string) => `spotify:track:${url.split('/track/')[1]?.split('?')[0] ?? ''}`;
// What the script needs for each song: its URI and loop, in seconds (to: 0 = the end of the song)
const songData = JSON.stringify(
  Object.fromEntries(Object.entries(songs).map(([k, v]) => [k, { uri: uriOf(v.spotify), from: seconds(v.loopFrom), to: seconds(v.loopTo) }])),
);
// Bars of the equalizer, left to right: 0 is a dot, higher numbers move more
const bars = [0, 1, 3, 2, 0, 0, 0, 2, 4, 3, 1, 0, 0, 2, 3, 0];
---

<div class="song-player" data-songs={songData}>
  <span class="eq" aria-hidden="true">
    {bars.map((size, i) => <span class="bar" style={`--size:${size};--i:${i}`}></span>)}
  </span>
  <button type="button" class="play tip-host" aria-label="Play">
    <!-- Lucide play and pause -->
    <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><polygon points="6 3 20 12 6 21 6 3" /></svg>
    <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="14" y="4" width="4" height="16" rx="1" /><rect x="6" y="4" width="4" height="16" rx="1" /></svg>
    <span class="tip" aria-hidden="true">Play</span>
  </button>
  <div class="spotify" aria-hidden="true"><div class="spotify-mount"></div></div>
</div>

<script>
  type Controller = {
    play(): void;
    pause(): void;
    loadUri(uri: string): void;
    resume(): void;
    seek(seconds: number): void;
    addListener(event: string, cb: (e: { data: { position: number; duration: number; isPaused: boolean } }) => void): void;
  };

  const root = document.querySelector<HTMLElement>('.song-player');
  if (root) {
    const button = root.querySelector<HTMLButtonElement>('.play')!;
    const tip = button.querySelector<HTMLElement>('.tip')!;
    const mount = root.querySelector<HTMLElement>('.spotify-mount')!;
    type Song = { uri: string; from: number; to: number };
    const songs = JSON.parse(root.dataset.songs!) as Record<'main' | 'redesigns', Song>;
    // The Redesigns page (body data-page="peek") has its own song
    const songForPage = () => (document.body.dataset.page === 'peek' ? songs.redesigns : songs.main);
    let song = songForPage();
    const KEY = 'song-player'; // remembers playing + song + position between pages

    let controller: Controller | null = null;
    let loading: Promise<Controller> | null = null;
    let wantPlaying = false;     // what the visitor asked for
    let started = false;         // jumped to the loop start yet?
    let resumeAt: number | null = null;
    let giveUp = 0;              // timer: no sound after asking to play (e.g. the browser blocked it)
    let preview = false;         // only Spotify's 30-second preview is available
    let lastPosition = -1;
    let lastProgressAt = 0;

    // Asked to play: if no sound comes within 4s, show it as paused again
    const expectSound = () => {
      clearTimeout(giveUp);
      giveUp = window.setTimeout(() => {
        wantPlaying = false;
        show(false);
        save(lastSaved);
      }, 4000);
    };

    const show = (playing: boolean) => {
      root.classList.toggle('is-playing', playing);
      button.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      tip.textContent = playing ? 'Pause' : 'Play';
    };

    // Load Spotify's embed API once, then create the (invisible) player
    const load = () => {
      loading ??= new Promise<Controller>((resolve) => {
        (window as unknown as { onSpotifyIframeApiReady: (api: unknown) => void }).onSpotifyIframeApiReady = (api) => {
          (api as { createController: (el: Element, o: object, cb: (c: Controller) => void) => void }).createController(
            mount,
            { uri: song.uri, width: 300, height: 80 },
            (c) => {
              controller = c;
              c.addListener('playback_update', (e) => {
                const { position, duration, isPaused } = e.data;
                preview = duration > 0 && duration <= 31000; // Spotify's 30-second preview
                if (position !== lastPosition) {
                  lastPosition = position;
                  lastProgressAt = performance.now();
                }
                if (!isPaused) clearTimeout(giveUp);
                if (!isPaused && !started) {
                  started = true;
                  const start = resumeAt ?? (preview ? 0 : song.from);
                  resumeAt = null;
                  if (start > 0) c.seek(start);
                }
                // The loop: back to the start when it reaches the end (or the preview runs out)
                const end = preview || !song.to ? duration / 1000 - 0.4 : song.to;
                if (!isPaused && duration > 0 && position / 1000 >= end) c.seek(preview ? 0 : song.from);
                // Still starting up: Spotify reports "paused" until the sound begins
                if (isPaused && wantPlaying && !started) return;
                show(!isPaused);
                if (!isPaused) save(position / 1000);
              });
              resolve(c);
            },
          );
        };
        const s = document.createElement('script');
        s.src = 'https://open.spotify.com/embed/iframe-api/v1';
        s.async = true;
        document.head.append(s);
      });
      return loading;
    };

    let lastSaved = 0;
    const save = (position: number) => {
      lastSaved = position;
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ playing: wantPlaying, position, uri: song.uri }));
      } catch {}
    };

    // Get Spotify ready before the first press. Phones only allow sound when the play
    // command is sent during the tap itself, so on touch screens it loads quietly
    // shortly after the page opens; with a mouse, when the pointer reaches the button.
    const touch = window.matchMedia('(hover: none)').matches;
    if (touch) window.setTimeout(load, 1200);
    button.addEventListener('pointerenter', load, { once: true });
    button.addEventListener('focus', load, { once: true });

    const toggle = (c: Controller) => {
      if (wantPlaying) {
        expectSound();
        lastProgressAt = performance.now() + 1500; // give it time to start before the watchdog steps in
        if (started) c.resume();
        else c.play();
      } else c.pause();
    };

    button.addEventListener('click', () => {
      wantPlaying = !root.classList.contains('is-playing');
      save(lastSaved);
      if (controller) {
        // Ready: send the command right away, inside the tap
        show(wantPlaying);
        toggle(controller);
        return;
      }
      // Pressed before Spotify was ready
      load().then((c) => {
        if (!wantPlaying) return;
        if (touch) {
          // On a phone, starting now (outside the tap) would play silently: wait for the next tap
          wantPlaying = false;
          show(false);
          return;
        }
        show(true);
        toggle(c);
      });
    });

    // Coming from another page while it was playing: try to carry on from the same spot.
    // Browsers usually block sound until the visitor clicks on the new page; then it shows
    // as paused, and pressing play continues from where it was.
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) ?? 'null');
      // (only the same song carries on; a different page's song starts from its beginning)
      if (saved?.playing) {
        if (saved.uri && saved.uri !== song.uri) saved.position = song.from;
        resumeAt = saved.position;
        lastSaved = saved.position;
        // Phones would play silently without a tap: there the next press carries on instead
        if (!touch) {
          wantPlaying = true;
          expectSound(); // shows as playing only once the sound actually starts
          load().then((c) => c.play());
        }
      }
    } catch {}

    // Watchdog: if it should be playing but hasn't moved for 1.5s (the preview ran out,
    // or the stream stalled), go back to the loop start and carry on
    window.setInterval(() => {
      if (!controller || !wantPlaying || !started) return;
      if (performance.now() - lastProgressAt < 1500) return;
      lastProgressAt = performance.now();
      controller.seek(preview ? 0 : song.from);
      controller.resume();
    }, 500);

    // Entering or leaving the Redesigns page: switch songs. If music was on, the new song
    // starts playing; if not, it's simply the one the button will play.
    document.addEventListener('astro:page-load', () => {
      const next = songForPage();
      if (next.uri === song.uri) return;
      song = next;
      started = false;
      resumeAt = null;
      lastSaved = song.from;
      save(lastSaved);
      if (!controller) return; // not loaded yet: it will load the right song when needed
      controller.loadUri(song.uri);
      if (wantPlaying) {
        expectSound();
        lastProgressAt = performance.now() + 1500;
        controller.play();
      } else {
        show(false);
      }
    });

    window.addEventListener('pagehide', () => save(lastSaved));
  }
</script>

<style>
  .song-player {
    position: fixed;
    right: 24px;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 10; /* with the nav: above the page transition */
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Glass, the same as the nav */
  .play,
  .eq {
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      var(--glass-tint);
    border: 1px solid var(--glass-rim);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 rgb(255 255 255 / 0.05),
      inset 0 0 16px rgb(255 255 255 / 0.04),
      0 14px 36px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    color: var(--color-text);
  }

  /* Round play / pause button, as tall as the nav */
  .play {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    cursor: pointer;
  }
  .play svg {
    grid-area: 1 / 1;
    width: 14px;
    height: 14px;
    fill: currentColor; /* solid, the stroke rounds the corners */
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .icon-pause,
  .is-playing .icon-play {
    opacity: 0;
    transform: scale(0.7);
  }
  .is-playing .icon-pause {
    opacity: 1;
    transform: scale(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .play:hover {
      color: var(--color-accent-2);
    }
  }

  /* Equalizer: short bars and dots that bounce while the song plays */
  .eq {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 40px;
    padding: 0 14px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility 0s linear var(--dur-base);
  }
  .is-playing .eq {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .bar {
    width: 2px;
    height: 16px;
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(0.125); /* a dot */
  }
  .is-playing .bar {
    animation: eq calc(520ms + var(--i) * 37ms) var(--ease-in-out) calc(var(--i) * -91ms) infinite alternate;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.125);
    }
    to {
      transform: scaleY(calc(0.125 + var(--size) * 0.22));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-playing .bar {
      animation: none;
      transform: scaleY(calc(0.125 + var(--size) * 0.15));
    }
  }

  /* The Spotify embed plays the sound but stays invisible, tucked behind the button */
  .spotify {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: -1;
    width: 300px;
    height: 80px;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  @media (max-width: 799.98px) {
    .song-player {
      right: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }
</style>
