---
// A small music player in the bottom right corner: a round play/pause button in the
// nav's glass style (with a play / pause tooltip above it), and a little equalizer
// next to it while the song plays.
//
// The music comes from Spotify's official embed, kept invisible. It only loads when
// someone reaches for the button, so pages stay fast and Spotify isn't contacted for
// visitors who never press play.
//
// Change the song and the loop here. Times are minutes:seconds; the song plays from
// loopFrom to loopTo, then jumps back to loopFrom.
// Note: visitors who aren't logged in to Spotify in their browser only get Spotify's
// own 30-second preview, so for them the preview loops instead.
const song = {
  spotify: 'https://open.spotify.com/track/2t9JBAhPDfgnvUlcL045qC',
  loopFrom: '0:00',
  loopTo: '2:00',
};

const seconds = (t: string) => t.split(':').reduce((sum, part) => sum * 60 + Number(part), 0);
const trackId = song.spotify.split('/track/')[1]?.split('?')[0] ?? '';
// Bars of the equalizer, left to right: 0 is a dot, higher numbers move more
const bars = [0, 1, 3, 2, 0, 0, 0, 2, 4, 3, 1, 0, 0, 2, 3, 0];
---

<div
  class="song-player"
  data-uri={`spotify:track:${trackId}`}
  data-from={seconds(song.loopFrom)}
  data-to={seconds(song.loopTo)}
>
  <span class="eq" aria-hidden="true">
    {bars.map((size, i) => <span class="bar" style={`--size:${size};--i:${i}`}></span>)}
  </span>
  <button type="button" class="play tip-host" aria-label="play">
    <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
    <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor"></path></svg>
    <span class="tip" aria-hidden="true">play</span>
  </button>
  <div class="spotify" aria-hidden="true"><div class="spotify-mount"></div></div>
</div>

<script>
  type Controller = {
    play(): void;
    pause(): void;
    resume(): void;
    seek(seconds: number): void;
    addListener(event: string, cb: (e: { data: { position: number; duration: number; isPaused: boolean } }) => void): void;
  };

  const root = document.querySelector<HTMLElement>('.song-player');
  if (root) {
    const button = root.querySelector<HTMLButtonElement>('.play')!;
    const tip = button.querySelector<HTMLElement>('.tip')!;
    const mount = root.querySelector<HTMLElement>('.spotify-mount')!;
    const uri = root.dataset.uri!;
    const from = Number(root.dataset.from);
    const to = Number(root.dataset.to);
    const KEY = 'song-player'; // remembers playing + position between pages

    let controller: Controller | null = null;
    let loading: Promise<Controller> | null = null;
    let wantPlaying = false;     // what the visitor asked for
    let started = false;         // jumped to the loop start yet?
    let resumeAt: number | null = null;
    let giveUp = 0;              // timer: no sound after asking to play (e.g. the browser blocked it)
    let preview = false;         // only Spotify's 30-second preview is available
    let lastPosition = -1;
    let lastProgressAt = 0;

    // Asked to play: if no sound comes within 4s, show it as paused again
    const expectSound = () => {
      clearTimeout(giveUp);
      giveUp = window.setTimeout(() => {
        wantPlaying = false;
        show(false);
        save(lastSaved);
      }, 4000);
    };

    const show = (playing: boolean) => {
      root.classList.toggle('is-playing', playing);
      button.setAttribute('aria-label', playing ? 'pause' : 'play');
      tip.textContent = playing ? 'pause' : 'play';
    };

    // Load Spotify's embed API once, then create the (invisible) player
    const load = () => {
      loading ??= new Promise<Controller>((resolve) => {
        (window as unknown as { onSpotifyIframeApiReady: (api: unknown) => void }).onSpotifyIframeApiReady = (api) => {
          (api as { createController: (el: Element, o: object, cb: (c: Controller) => void) => void }).createController(
            mount,
            { uri, width: 300, height: 80 },
            (c) => {
              controller = c;
              c.addListener('playback_update', (e) => {
                const { position, duration, isPaused } = e.data;
                preview = duration > 0 && duration <= 31000; // Spotify's 30-second preview
                if (position !== lastPosition) {
                  lastPosition = position;
                  lastProgressAt = performance.now();
                }
                if (!isPaused) clearTimeout(giveUp);
                if (!isPaused && !started) {
                  started = true;
                  const start = resumeAt ?? (preview ? 0 : from);
                  resumeAt = null;
                  if (start > 0) c.seek(start);
                }
                // The loop: back to the start when it reaches the end (or the preview runs out)
                const end = preview ? duration / 1000 - 0.4 : to;
                if (!isPaused && position / 1000 >= end) c.seek(preview ? 0 : from);
                // Still starting up: Spotify reports "paused" until the sound begins
                if (isPaused && wantPlaying && !started) return;
                show(!isPaused);
                if (!isPaused) save(position / 1000);
              });
              resolve(c);
            },
          );
        };
        const s = document.createElement('script');
        s.src = 'https://open.spotify.com/embed/iframe-api/v1';
        s.async = true;
        document.head.append(s);
      });
      return loading;
    };

    let lastSaved = 0;
    const save = (position: number) => {
      lastSaved = position;
      try {
        sessionStorage.setItem(KEY, JSON.stringify({ playing: wantPlaying, position }));
      } catch {}
    };

    // Get Spotify ready as soon as someone reaches for the button
    button.addEventListener('pointerenter', load, { once: true });
    button.addEventListener('focus', load, { once: true });

    button.addEventListener('click', async () => {
      wantPlaying = !root.classList.contains('is-playing');
      show(wantPlaying);
      save(lastSaved);
      const c = controller ?? (await load());
      if (wantPlaying) {
        expectSound();
        lastProgressAt = performance.now() + 1500; // give it time to start before the watchdog steps in
        if (started) c.resume();
        else c.play();
      } else c.pause();
    });

    // Coming from another page while it was playing: try to carry on from the same spot.
    // Browsers usually block sound until the visitor clicks on the new page; then it shows
    // as paused, and pressing play continues from where it was.
    try {
      const saved = JSON.parse(sessionStorage.getItem(KEY) ?? 'null');
      if (saved?.playing) {
        wantPlaying = true;
        resumeAt = saved.position;
        lastSaved = saved.position;
        expectSound(); // shows as playing only once the sound actually starts
        load().then((c) => c.play());
      }
    } catch {}

    // Watchdog: if it should be playing but hasn't moved for 1.5s (the preview ran out,
    // or the stream stalled), go back to the loop start and carry on
    window.setInterval(() => {
      if (!controller || !wantPlaying || !started) return;
      if (performance.now() - lastProgressAt < 1500) return;
      lastProgressAt = performance.now();
      controller.seek(preview ? 0 : from);
      controller.resume();
    }, 500);

    window.addEventListener('pagehide', () => save(lastSaved));
  }
</script>

<style>
  .song-player {
    position: fixed;
    right: 24px;
    bottom: max(24px, env(safe-area-inset-bottom));
    z-index: 10; /* with the nav: above the page transition */
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Glass, the same as the nav */
  .play,
  .eq {
    background:
      linear-gradient(180deg, var(--glass-sheen-top), var(--glass-sheen-bottom)),
      var(--glass-tint);
    border: 1px solid var(--glass-rim);
    border-radius: var(--radius-pill);
    box-shadow:
      inset 0 1px 0 var(--glass-highlight),
      inset 0 -1px 0 rgb(255 255 255 / 0.05),
      inset 0 0 16px rgb(255 255 255 / 0.04),
      0 14px 36px rgb(0 0 0 / 0.5),
      0 2px 8px rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(24px) saturate(160%) brightness(0.7);
    backdrop-filter: blur(24px) saturate(160%) brightness(0.7);
    color: var(--color-text);
  }

  /* Round play / pause button, as tall as the nav */
  .play {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    padding: 0;
    cursor: pointer;
  }
  .play svg {
    grid-area: 1 / 1;
    width: 22px;
    height: 22px;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .icon-pause,
  .is-playing .icon-play {
    opacity: 0;
    transform: scale(0.7);
  }
  .is-playing .icon-pause {
    opacity: 1;
    transform: scale(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .play:hover {
      color: var(--color-accent-2);
    }
  }

  /* Equalizer: short bars and dots that bounce while the song plays */
  .eq {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 40px;
    padding: 0 14px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(8px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility 0s linear var(--dur-base);
  }
  .is-playing .eq {
    opacity: 1;
    visibility: visible;
    transform: translateX(0);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .bar {
    width: 2px;
    height: 16px;
    border-radius: 1px;
    background: currentColor;
    transform: scaleY(0.125); /* a dot */
  }
  .is-playing .bar {
    animation: eq calc(520ms + var(--i) * 37ms) var(--ease-in-out) calc(var(--i) * -91ms) infinite alternate;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.125);
    }
    to {
      transform: scaleY(calc(0.125 + var(--size) * 0.22));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-playing .bar {
      animation: none;
      transform: scaleY(calc(0.125 + var(--size) * 0.15));
    }
  }

  /* The Spotify embed plays the sound but stays invisible, tucked behind the button */
  .spotify {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: -1;
    width: 300px;
    height: 80px;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
  }

  @media (max-width: 799.98px) {
    .song-player {
      right: 16px;
      bottom: max(16px, env(safe-area-inset-bottom));
    }
  }
</style>
