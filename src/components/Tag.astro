---
// Small pill tag in Cormorant Garamond Italic: "open to work", "soon".
// `dot` adds the green status dot in front of the label.
interface Props {
  dot?: boolean;
  tone?: 'default' | 'soon';
}

const { dot = false, tone = 'default' } = Astro.props;
---

<span class:list={['tag', `tag--${tone}`]}>
  {dot && <span class="dot" aria-hidden="true"></span>}
  <span class="label"><slot /></span>
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 12px 5px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-tag);
    border-radius: var(--radius-pill);
    font-family: var(--font-tag);
    font-style: italic;
    font-weight: 400;
    font-size: var(--text-tag);
    line-height: 19px; /* Figma "auto" for this font, gives the 28px pill */
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .tag--soon {
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
  }

  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    margin-top: 3px; /* optical centre against the italic x-height */
    border-radius: 50%;
    background: var(--color-status);
  }
</style>
