---
// Small pill tag in Google Sans Flex: "open to work", "soon",
// and the About page pills ("how i work" in purple, "tech skills" in green).
// `dot` adds the green status dot in front of the label.
interface Props {
  dot?: boolean;
  tone?: 'default' | 'soon' | 'work' | 'skill';
}

const { dot = false, tone = 'default' } = Astro.props;
---

<span class:list={['tag', `tag--${tone}`]}>
  {dot && <span class="dot" aria-hidden="true"></span>}
  <span class="label"><slot /></span>
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border-tag);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: normal;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .tag--soon {
    color: var(--color-text-muted);
  }

  .tag--work {
    background: var(--color-pill-work-bg);
    border-color: var(--color-pill-work-border);
    color: var(--color-text);
  }

  .tag--skill {
    background: var(--color-pill-skill-bg);
    border-color: var(--color-pill-skill-border);
    color: var(--color-text);
  }

  .dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-status);
  }
</style>
