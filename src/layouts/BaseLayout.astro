---
// Shared page shell: <head>, fonts, global styles and the floating nav.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import PageGlitch from '../components/PageGlitch.astro';
import type { PaletteName } from '../data/palettes';

interface Props {
  title: string;
  description?: string;
  palette?: PaletteName; // colours of the page-load glitch
  theme?: 'calastone' | 'bamboo' | 'juicyway'; // case study tint (also sets the glitch colours)
}

const { title, description, theme } = Astro.props;
const palette: PaletteName = Astro.props.palette ?? theme ?? 'neutral';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Preload the fonts used above the fold -->
    <link rel="preload" href="/fonts/cs-ariston-halfpixel.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans-flex-300-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-theme={theme}>
    <Nav />
    <slot />
    <PageGlitch palette={palette} />

    <script>
      import '../scripts/tooltips';
    </script>
  </body>
</html>
