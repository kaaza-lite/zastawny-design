---
// Shared page shell: <head>, fonts, global styles and the floating nav.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import PageMosh from '../components/PageMosh.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'calastone' | 'bamboo' | 'juicyway'; // case study tint
}

const { title, description, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Arriving from another page of this site: show the last frame of the old page from the
         very first paint, until the transition takes over (see PageMosh) -->
    <script is:inline>
      try {
        var frame = sessionStorage.getItem('mosh-frame');
        if (frame && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('mosh-in');
          document.documentElement.style.setProperty('--mosh-frame', 'url("' + frame + '")');
        }
      } catch (e) {}
    </script>

    <!-- Favicon: the "z" from the mobile nav, on the page background -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preload the fonts used above the fold -->
    <link rel="preload" href="/fonts/cs-ariston-halfpixel.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans-flex-300-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-theme={theme}>
    <Nav />
    <slot />
    <PageMosh />

    <script>
      import '../scripts/tooltips';
    </script>
  </body>
</html>
