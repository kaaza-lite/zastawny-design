---
// Shared page shell: <head>, fonts, global styles and the floating nav.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import PageMosh from '../components/PageMosh.astro';
import CursorGlow from '../components/CursorGlow.astro';
import SongPlayer from '../components/SongPlayer.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'calastone' | 'bamboo' | 'juicyway'; // case study tint
}

const { title, description, theme } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <!-- Page changes without reloading, so the music keeps playing (see src/scripts/navigation.ts) -->
    <ClientRouter />

    <!-- Favicon: the "z" from the mobile nav, on the page background -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preload the fonts used above the fold -->
    <link rel="preload" href="/fonts/cs-ariston-halfpixel.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans-flex-300-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-theme={theme}>
    <CursorGlow />
    <Nav />
    <slot />
    <PageMosh />
    <SongPlayer />

    <script>
      import '../scripts/navigation';
      import '../scripts/tooltips';
      import { initPills } from '../scripts/pills';
      // Pills you can grab and throw (see src/scripts/pills.ts)
      document.addEventListener('astro:page-load', () => {
        if (document.querySelector('[data-pill-group]')) initPills();
      });
    </script>
  </body>
</html>
